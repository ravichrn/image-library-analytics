<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Image Library Analytics</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
:root {
  --fs-card-title: 0.76rem;
  --fs-card-desc:  0.86rem;
  --fs-label:      0.78rem;
  --fs-body:       0.83rem;
  --fs-sub:        0.75rem;
  --fs-micro:      0.66rem;
  --fs-stat-v:     1.3rem;
  --fs-strip-v:    1.2rem;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #09090e;
  color: #d8d8e4;
  line-height: 1.65;
  font-size: 15px;
  display: flex;
}
#sidebar {
  width: 180px; min-width: 180px; position: sticky; top: 0; height: 100vh;
  overflow-y: auto; background: #0c0c14; border-right: 1px solid #1a1a2e;
  padding: 1.2rem 0; flex-shrink: 0; z-index: 100;
}
#sidebar .sb-logo { font-size: 0.6rem; font-weight: 800; color: #7c6af7; text-transform: uppercase;
  letter-spacing: 0.14em; padding: 0 1.2rem 1.2rem; border-bottom: 1px solid #1a1a2e; margin-bottom: 0.6rem; }
#sidebar .sb-label { font-size: 0.58rem; color: #3a3a5a; text-transform: uppercase;
  letter-spacing: 0.1em; padding: 0.9rem 1.2rem 0.3rem; }
#sidebar a { display: block; font-size: 0.76rem; color: #7878a0; padding: 0.42rem 1.2rem;
  text-decoration: none; border-left: 2px solid transparent; transition: color 0.12s, border-color 0.12s; }
#sidebar a:hover { color: #b8b8d0; border-left-color: #4a4a7a; }
#sidebar a.sb-active { color: #c8c8de; border-left-color: #7c6af7; }
#main-content { flex: 1; min-width: 0; }
.page { max-width: 1160px; margin: 0 auto; padding: 0 1.5rem 6rem; }
@media (max-width: 900px) { #sidebar { display: none; } body { display: block; } }

/* ── Hero ──────────────────────────────────────────────────────── */
.hero {
  padding: 3.5rem 0 2.5rem;
  border-bottom: 1px solid #17172a;
  margin-bottom: 3rem;
}
.hero-label {
  font-size: 0.65rem; color: #7878a0; text-transform: uppercase;
  letter-spacing: 0.18em; font-weight: 600; margin-bottom: 0.6rem;
}
.hero-title {
  font-size: 3.5rem; font-weight: 900; letter-spacing: -0.04em;
  color: #fff; line-height: 1.0; margin-bottom: 0.5rem;
}
.hero-sub {
  font-size: 0.82rem; color: #8080aa;
  margin-bottom: 2.5rem;
}
.hero-digest {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 0;
  border: 1px solid #17172a;
  border-radius: 12px;
  overflow: hidden;
}
.hero-digest-item {
  padding: 1.1rem 1.4rem;
  border-right: 1px solid #17172a;
}
.hero-digest-item:last-child { border-right: none; }
.hd-label { font-size: 0.72rem; color: #8080aa; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
.hd-value { font-size: 1.15rem; font-weight: 700; color: #e0e0ee; }
.hd-sub { font-size: 0.72rem; color: #7878a0; margin-top: 0.18rem; }

/* ── Section title ─────────────────────────────────────────────── */
.s-title {
  font-size: 0.62rem; font-weight: 700; color: #7878a0;
  text-transform: uppercase; letter-spacing: 0.14em;
  margin-bottom: 0.75rem;
}

/* ── Base card ─────────────────────────────────────────────────── */
.card {
  background: #111118;
  border: 1px solid #1c1c2e;
  border-radius: 14px;
  padding: 1.4rem 1.6rem;
}
.card-title {
  font-size: var(--fs-card-title); font-weight: 700; color: #7878a0;
  text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.8rem;
}
.card-title span { font-size: var(--fs-micro); font-weight: 400; }
.card-desc { font-size: var(--fs-card-desc); color: #7878a8; margin-top: -0.3rem; margin-bottom: 0.9rem; line-height: 1.55; }
.naked { background: transparent; border-color: transparent; padding: 0; }

/* ── Accent cards ──────────────────────────────────────────────── */
.card-accent-top { border-top: 2px solid #7c6af7; }
.card-warm { background: #130f0a; border-color: #2a1e10; }
.card-purple { background: #0f0d1f; border-color: #1e1a3a; }

/* ── Layout ────────────────────────────────────────────────────── */
.row { display: grid; gap: 1rem; margin-bottom: 1rem; }
.two   { grid-template-columns: 1fr 1fr; }
.three { grid-template-columns: 1fr 1fr 1fr; }
.c3-2  { grid-template-columns: 3fr 2fr; }
.c2-3  { grid-template-columns: 2fr 3fr; }
.c4-8  { grid-template-columns: 4fr 8fr; }
.c5-7  { grid-template-columns: 5fr 7fr; }
.c7-5  { grid-template-columns: 7fr 5fr; }
@media (max-width: 780px) {
  .two, .three, .c3-2, .c2-3, .c4-8, .c5-7, .c7-5 { grid-template-columns: 1fr; }
  #color-board-inner { grid-template-columns: 1fr !important; }
}
.mb { margin-bottom: 1rem; }

/* ── Stats ─────────────────────────────────────────────────────── */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px,1fr)); gap: 0.75rem; }
.stat { background: #16161f; border-radius: 8px; padding: 0.85rem 1rem; }
.stat-l { font-size: var(--fs-sub); color: #8080aa; text-transform: uppercase; letter-spacing: 0.06em; }
.stat-v { font-size: var(--fs-stat-v); font-weight: 700; color: #ddd8f0; margin-top: 0.15rem; }
.stat-s { font-size: var(--fs-sub); color: #7878a0; margin-top: 0.1rem; }

/* Inline strip */
.strip { display: flex; border: 1px solid #1c1c2e; border-radius: 10px; overflow: hidden; }
.strip-item { flex: 1; padding: 0.85rem 1.1rem; border-right: 1px solid #1c1c2e; }
.strip-item:last-child { border-right: none; }
.strip-v { font-size: var(--fs-strip-v); font-weight: 700; color: #ddd8f0; }
.strip-l { font-size: var(--fs-sub); color: #8080a8; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.12rem; }
.strip-s { font-size: var(--fs-sub); color: #7878a0; margin-top: 0.08rem; }

/* ── Bar lists ─────────────────────────────────────────────────── */
.bar-list { display: flex; flex-direction: column; gap: 0.45rem; }
.bar-row { display: flex; align-items: center; gap: 0.65rem; }
.bar-lbl { font-size: var(--fs-body); color: #8888aa; text-align: right; flex-shrink: 0; min-width: 0; }
.bar-track { flex: 1; height: 7px; background: #1a1a28; border-radius: 4px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 4px; }
.bar-val { font-size: var(--fs-sub); color: #7878a8; min-width: 42px; text-align: right; flex-shrink: 0; }

/* ── Small bar (dist) ───────────────────────────────────────────── */
.dbar { margin-bottom: 0.45rem; }
.dbar-row { display: flex; justify-content: space-between; font-size: var(--fs-body); margin-bottom: 3px; }
.dbar-row span:first-child { color: #8888aa; }
.dbar-row span:last-child { color: #7878a8; }
.dbar-bg { height: 5px; background: #1a1a28; border-radius: 3px; }
.dbar-fill { height: 5px; border-radius: 3px; }

/* ── Table ─────────────────────────────────────────────────────── */
table { width: 100%; border-collapse: collapse; font-size: var(--fs-body); }
th { text-align: left; color: #7878a8; font-weight: 600; padding: 0.35rem 0.8rem;
     border-bottom: 1px solid #1c1c2e; text-transform: uppercase; font-size: var(--fs-sub); letter-spacing: 0.06em; }
td { padding: 0.5rem 0.8rem; border-bottom: 1px solid #141420; color: #9090b8; }
tr:last-child td { border-bottom: none; }
.badge { display: inline-block; background: #1c1c2e; border-radius: 4px; padding: 3px 8px; font-size: var(--fs-label); margin: 2px; color: #6a6a90; }

/* ── Chart wraps ───────────────────────────────────────────────── */
.chart-h { position: relative; }
canvas { max-height: 300px; }

/* ── Swatches ──────────────────────────────────────────────────── */
.swatches { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 1rem; }
.swatch { width: 28px; height: 28px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.04); }

/* ── Composition patterns ──────────────────────────────────────── */
.cp-list { display: flex; flex-direction: column; gap: 0.45rem; }
.cp-row { display: flex; align-items: flex-start; gap: 0.6rem; }
.cp-pct { font-size: 0.73rem; font-weight: 700; min-width: 35px; text-align: right; color: #7070901; flex-shrink: 0; padding-top: 1px; color: #6060881; }
.cp-body {}
.cp-name { font-size: var(--fs-body); color: #c0c0d8; font-weight: 600; }
.cp-desc { font-size: var(--fs-sub); color: #7878a8; line-height: 1.45; margin-top: 2px; }
.cp-bar { height: 3px; background: #1a1a28; border-radius: 2px; margin-top: 4px; }
.cp-bar-fill { height: 3px; border-radius: 2px; background: #10b981; }

/* ── Grid heatmap ──────────────────────────────────────────────── */
.heatmap { display: grid; grid-template-columns: repeat(3,1fr); gap: 3px; max-width: 180px; }
.hm-cell { aspect-ratio: 1; border-radius: 3px; display: flex; align-items: center; justify-content: center;
           font-size: 0.63rem; font-weight: 600; color: rgba(255,255,255,0.55); }

/* ── Sig bars ──────────────────────────────────────────────────── */
.sig-row { margin-bottom: 6px; }
.sig-lbl { display: flex; justify-content: space-between; font-size: 0.78rem; margin-bottom: 3px; }
.sig-lbl span:first-child { color: #9090b8; }
.sig-lbl span:last-child { color: #7878a8; }
.sig-track { position: relative; height: 5px; background: #1a1a28; border-radius: 3px; }
.sig-center { position: absolute; left: 50%; top: 0; width: 1px; height: 100%; background: #2a2a3e; }
.sig-pos { position: absolute; top: 0; height: 100%; border-radius: 0 3px 3px 0; }
.sig-neg { position: absolute; top: 0; height: 100%; border-radius: 3px 0 0 3px; right: 50%; }

/* ── Pull quote ────────────────────────────────────────────────── */
.pull {
  font-style: italic; color: #9090b8; font-size: 0.85rem; line-height: 1.75;
  border-left: 2px solid #7c6af7; padding: 0.55rem 1rem 0.55rem 1rem;
  background: #0f0d1e; border-radius: 0 8px 8px 0; margin-bottom: 1.4rem;
}

/* ── Editing style editorial ────────────────────────────────────── */
.style-editorial {
  display: flex; flex-direction: column; justify-content: center;
  padding: 1.5rem 0;
}
.style-name {
  font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em;
  color: #7c6af7; line-height: 1.1; margin-bottom: 0.35rem;
}
.style-conf { font-size: var(--fs-sub); color: #8080aa; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
.style-meaning { font-size: var(--fs-body); color: #8080a8; line-height: 1.65; max-width: 520px; }

/* ── Scene tiles ────────────────────────────────────────────────── */
.scene-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.75rem; }
.scene-tile {
  background: #111118; border: 1px solid #1c1c2e; border-radius: 10px;
  padding: 1rem 1.1rem; position: relative; overflow: hidden;
}
.scene-tile::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
}
.scene-tile-name { font-size: var(--fs-body); color: #9090b0; font-weight: 600; margin-bottom: 0.4rem; text-transform: capitalize; }
.scene-tile-count { font-size: 1.6rem; font-weight: 800; color: #e0e0ee; letter-spacing: -0.02em; line-height: 1; }
.scene-tile-score { font-size: var(--fs-label); color: #7878a0; margin-top: 0.25rem; }
.scene-tile-bar { height: 3px; background: #1a1a28; border-radius: 2px; margin-top: 0.6rem; }
.scene-tile-bar-fill { height: 3px; border-radius: 2px; }

/* ── Aesthetic score by scene ───────────────────────────────────── */
.aes-scene-list { display: flex; flex-direction: column; gap: 0.55rem; }
.aes-scene-row { display: flex; align-items: center; gap: 0.75rem; }
.aes-scene-name { font-size: var(--fs-body); color: #8888aa; min-width: 140px; text-align: right; flex-shrink: 0; text-transform: capitalize; }
.aes-scene-bar-wrap { flex: 1; position: relative; height: 20px; background: #141420; border-radius: 5px; overflow: hidden; }
.aes-scene-bar-fill { height: 100%; border-radius: 5px; display: flex; align-items: center; padding-left: 8px; }
.aes-scene-score { font-size: var(--fs-label); font-weight: 700; color: rgba(255,255,255,0.8); white-space: nowrap; }
.aes-scene-count { font-size: var(--fs-label); color: #7878a0; min-width: 60px; text-align: left; }

/* ── Color scene cards ──────────────────────────────────────────── */
.color-scene-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px,1fr)); gap: 0.65rem; }
.color-scene-card {
  border-radius: 9px; padding: 0.85rem 1rem; border: 1px solid #1c1c2e;
}
.cs-name { font-size: var(--fs-label); font-weight: 600; color: #9090b0; margin-bottom: 0.5rem; text-transform: capitalize; }
.cs-temp { font-size: 1rem; font-weight: 700; margin-bottom: 0.2rem; }
.cs-pills { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 0.5rem; }
.cs-pill { font-size: var(--fs-micro); background: rgba(255,255,255,0.04); border-radius: 3px; padding: 2px 5px; color: #5a5a78; }

/* ── Flag rows ──────────────────────────────────────────────────── */
.flag-row { padding: 0.8rem 0; border-bottom: 1px solid #141420; }
.flag-row:last-child { border-bottom: none; }
.flag-hd { display: flex; align-items: center; gap: 0.7rem; }
.flag-pct { font-size: 1rem; font-weight: 700; min-width: 44px; text-align: right; flex-shrink: 0; }
.flag-pct.hi { color: #f87171; } .flag-pct.md { color: #fbbf24; } .flag-pct.lo { color: #7878a0; }
.flag-info { flex: 1; }
.flag-name { font-size: var(--fs-body); color: #c8c8de; font-weight: 500; }
.flag-meta { font-size: var(--fs-label); color: #8080aa; margin-top: 2px; }
.flag-bar { height: 3px; background: #1a1a28; border-radius: 2px; margin-top: 4px; }
.flag-bar-fill { height: 3px; border-radius: 2px; background: #7c6af7; }
.flag-desc { font-size: var(--fs-body); color: #8080aa; margin-top: 0.4rem; line-height: 1.55; padding-left: 56px; }

/* ── Aesthetic narrow range notice ─────────────────────────────── */
.range-note {
  background: #0f0e1a; border: 1px solid #1e1a3a; border-radius: 8px;
  padding: 0.9rem 1.1rem; font-size: 0.78rem; color: #8080aa; line-height: 1.6;
  margin-bottom: 1rem;
}

/* ── Pattern grid ───────────────────────────────────────────────── */
.pattern-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: 0.7rem; }
.pattern-card { background: #16161f; border-radius: 8px; padding: 0.85rem 1rem; border-left: 3px solid #1c1c2e; }
.pattern-card.dom { border-left-color: #7c6af7; }
.pattern-card.mod { border-left-color: #f97316; }
.ptn-name { font-size: var(--fs-body); font-weight: 600; color: #c8c8de; }
.ptn-conf-row { display: flex; align-items: center; gap: 0.5rem; margin: 0.35rem 0; }
.ptn-conf-bar { flex: 1; height: 4px; background: #1c1c2e; border-radius: 2px; }
.ptn-conf-fill { height: 4px; border-radius: 2px; }
.ptn-pct { font-size: var(--fs-sub); color: #7878a0; min-width: 38px; text-align: right; }
.ptn-desc { font-size: var(--fs-body); color: #8080aa; line-height: 1.55; margin-top: 0.3rem; }

/* ── Back to top ────────────────────────────────────────────────── */
#back-to-top {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(124,106,247,0.12);
  border: 1px solid rgba(124,106,247,0.28);
  color: #7c6af7;
  font-size: 1.1rem;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s, background 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
#back-to-top.visible { opacity: 1; pointer-events: auto; }
#back-to-top:hover { background: rgba(124,106,247,0.28); }
</style>
</head>
<body>

<nav id="sidebar">
  <div class="sb-logo">Analytics</div>
  <div class="sb-label">Library</div>
  <a href="#s-overview">Overview</a>
  <div class="sb-label">Explore</div>
  <a href="#s-semantic">What You Shoot</a>
  <a href="#s-technical">How You Shoot</a>
  <a href="#s-aesthetics">Editing &amp; Aesthetics</a>
  <a href="#s-when">When You Shoot</a>
  <div class="sb-label">Signals</div>
  <a href="#s-forensics">Forensics</a>
</nav>

<div id="main-content">
<div class="page">

<!-- ══════════════════════════════════════ HERO ══════════════════ -->
<div class="hero" id="s-overview">
  <h1 class="hero-title" style="font-size:1.9rem;letter-spacing:0.04em;font-weight:800;text-transform:uppercase;color:#c8c8de;">Image Library Analytics</h1>
  <p class="hero-sub">{{ photo_count }} images · analyzed entirely on-device · CLIP ViT-L/14 · LAION Aesthetic MLP · DINOv2 · Depth Anything v2 · Florence-2 · RMBG-1.4</p>
  <div class="stat-grid">
    <div class="stat">
      <div class="stat-l">Dominant Scene</div>
      {% set dom_pct = (scene_dist.get(agg.scene_stats.dominant_scene, 0) / (scene_dist.values()|sum) * 100)|round|int if scene_dist.values()|sum > 0 else 0 %}
      <div class="stat-v" style="font-size:1.1rem;text-transform:capitalize;">{{ agg.scene_stats.dominant_scene or "—" }}</div>
      <div class="stat-s">{{ dom_pct }}% of library</div>
    </div>
    <div class="stat">
      <div class="stat-l">Avg Aesthetic Score</div>
      <div class="stat-v">{{ "%.1f"|format(aesthetic_stats.avg_score or 0) }}<span style="font-size:0.78rem;font-weight:400;color:#7878a0;"> / 100</span></div>
      <div class="stat-s">range {{ "%.0f"|format(aesthetic_stats.min_score or 0) }}–{{ "%.0f"|format(aesthetic_stats.max_score or 0) }}</div>
    </div>
    <div class="stat">
      <div class="stat-l">Visual Clusters</div>
      <div class="stat-v">{{ clusters.n_clusters or "—" }}</div>
      <div class="stat-s">DINOv2 + KMeans</div>
    </div>
    <div class="stat">
      <div class="stat-l">Avg Resolution</div>
      <div class="stat-v">{{ "%.1f"|format(megapixel_stats.avg or 0) }}<span style="font-size:0.78rem;font-weight:400;color:#7878a0;">MP</span></div>
      <div class="stat-s">{{ megapixel_stats.min }}–{{ megapixel_stats.max }}MP range</div>
    </div>
    <div class="stat">
      <div class="stat-l">Exposure Bias</div>
      <div class="stat-v">{{ "%+.2f"|format(exposure_stats.avg_bias or 0) }}</div>
      <div class="stat-s">0 = neutral</div>
    </div>
    <div class="stat">
      <div class="stat-l">Editing Style</div>
      <div class="stat-v" style="font-size:1.0rem;">{% if editing_style_patterns %}{{ editing_style_patterns[0].name }}{% else %}—{% endif %}</div>
      <div class="stat-s">{% if editing_style_patterns %}{{ "%.0f"|format(editing_style_patterns[0].confidence * 100) }}% confidence{% endif %}</div>
    </div>
    {% if storage_tiers and storage_tiers.redundant_count %}
    <div class="stat">
      <div class="stat-l">Redundant Images</div>
      <div class="stat-v">{{ storage_tiers.redundant_count }}</div>
      <div class="stat-s">similar image duplicates</div>
    </div>
    {% endif %}
    {% if ela_stats and ela_stats.extreme_outlier_count is defined and ela_stats.extreme_outlier_count > 0 %}
    <div class="stat">
      <div class="stat-l">ELA Outliers</div>
      <div class="stat-v">{{ ela_stats.extreme_outlier_count }}</div>
      <div class="stat-s">unusual compression artifacts</div>
    </div>
    {% endif %}
  </div>
</div>

<!-- ══════════════════════════════════════ WHAT YOU SHOOT ══════════════════ -->
<div id="s-semantic"></div>

<!-- Scene Preferences (pie) + Visual Attributes -->
<div class="row c4-8 mb">
  <div class="card">
    <div class="card-title">Scene Preferences</div>
    <div class="chart-h"><canvas id="sceneChart"></canvas></div>
  </div>
  {% set va = visual_attributes %}
  {% if va and va.total_analyzed %}
  <div class="card">
    <div class="card-title">Visual Attributes <span style="color:#8080aa;font-size:0.6rem;font-weight:400;">Florence-2 VQA · {{ va.total_analyzed }} images</span></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;">
      {% set attr_meta = [("season","Season","#ec4899"),("has_person","People Present","#7c6af7"),("setting","Setting","#10b981"),("time_of_day","Time of Day","#f59e0b"),("weather","Weather","#3b82f6")] %}
      {% for key, label, color in attr_meta %}
      {% set items = va.get(key, []) %}{% if items %}
      <div>
        <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">{{ label }}</div>
        {% for item in items %}
        <div style="margin-bottom:4px;">
          <div style="display:flex;justify-content:space-between;margin-bottom:2px;">
            <span style="font-size:0.78rem;color:#7878a0;text-transform:capitalize;">{{ item.label }}</span>
            <span style="font-size:0.78rem;color:#7878a0;">{{ item.pct }}%</span>
          </div>
          <div style="background:#16161f;border-radius:3px;height:5px;">
            <div style="width:{{ item.pct }}%;background:{{ color }};border-radius:3px;height:5px;opacity:0.75;"></div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}{% endfor %}
    </div>


  </div>
  {% endif %}
</div>

<!-- UMAP — compact -->
<div class="card mb" style="padding: 1.2rem 1.6rem;">
  <div class="card-title">Visual Similarity Map <span style="color:#8080aa;font-weight:400;font-size:0.6rem;">{{ umap_points|length }} of {{ umap_total }} images · colored by scene · hover for details</span></div>
  <div class="card-desc" style="margin-bottom:0.8rem;">Each dot is an image, positioned by visual similarity using <strong style="color:#9090b8;">UMAP</strong> on 768-dimensional DINOv2 embeddings. Proximity = visual similarity — dots close together look alike, dots far apart look different. An image isolated at the edge has a visual character unlike most others in your library. Clusters that overlap scene colours reflect consistent visual style across different subject categories.</div>
  <div class="chart-h" style="height:280px;"><canvas id="umapChart" style="max-height:280px;"></canvas></div>
</div>

<!-- ══════════════════════════════════════ HOW YOU SHOOT ══════════════════ -->
<div id="s-technical"></div>

<!-- Focal / Aperture / ISO -->
{% if focal_length_histogram or aperture_histogram or iso_histogram %}
<div class="row {% if (focal_length_histogram and aperture_histogram and iso_histogram) %}three{% elif focal_length_histogram and aperture_histogram %}two{% else %}two{% endif %} mb">
  {% if focal_length_histogram %}
  <div class="card">
    <div class="card-title">Focal Length</div>
    <div class="chart-h"><canvas id="focalChart"></canvas></div>
  </div>
  {% endif %}
  {% if aperture_histogram %}
  <div class="card">
    <div class="card-title">Aperture</div>
    <div class="chart-h"><canvas id="apertureChart"></canvas></div>
  </div>
  {% endif %}
  {% if iso_histogram %}
  <div class="card">
    <div class="card-title">ISO Sensitivity</div>
    <div class="chart-h"><canvas id="isoChart"></canvas></div>
  </div>
  {% endif %}
</div>
{% endif %}

<!-- Composition Analysis -->
<div class="row c7-5 mb">

  <!-- LEFT: Composition Style — pattern list + metrics strip -->
  <div class="card">
    <div class="card-title">Composition Style</div>
    {% if composition_patterns %}
    {% set cp_descs = {
      "Rule of Thirds": "Subject or key element placed near a thirds intersection, adding visual tension and naturally directing the viewer's eye across the frame.",
      "Subject Isolation": "Centre zone is significantly sharper than the surroundings — the subject pops cleanly from its background via shallow depth of field or high contrast.",
      "Strong Symmetry": "High left/right mirroring across the frame, common in architectural subjects, reflections, or deliberately geometric compositions.",
      "Negative Space": "Unusually large empty areas surround the subject, giving it room to breathe and drawing the viewer's attention through contrast with the void.",
      "Foreground Interest": "Complex edge density in the bottom zone indicates foreground elements that add depth, texture, or layering to the scene.",
    } %}
    <div class="cp-list" style="margin-bottom:1.25rem;">
      {% for p in composition_patterns %}
      <div class="cp-row">
        <div class="cp-pct">{{ p.pct }}%</div>
        <div class="cp-body" style="flex:1;">
          <div class="cp-name">{{ p.name }}</div>
          <div class="cp-desc">{{ cp_descs.get(p.name, p.description) }}</div>
          <div class="cp-bar"><div class="cp-bar-fill" style="width:{{ [p.pct,100]|min }}%;"></div></div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <div class="strip">
      {% for lbl, val, sub in [
        ("Thirds Score", composition_stats.avg_thirds_score, "0 = centred · 1 = off-centre"),
        ("Symmetry", composition_stats.avg_symmetry_score, "left/right mirror ratio"),
        ("Negative Space", composition_stats.avg_negative_space, "empty-frame fraction"),
        ("Subject Isolation", composition_stats.avg_subject_isolation, "centre sharpness ratio"),
        ("Foreground Clutter", composition_stats.avg_foreground_clutter, "lower = cleaner frame"),
      ] %}
      <div class="strip-item">
        <div class="strip-l" style="margin-bottom:0.25rem;">{{ lbl }}</div>
        <div class="strip-v" style="font-size:1rem;">{{ "%.2f"|format(val or 0) }}</div>
        <div class="strip-s">{{ sub }}</div>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- RIGHT: Composition Grid -->
  <div class="card">
    <div class="card-title">Composition Grid</div>
    {% if grid_heatmap %}
    {% set flat = [] %}{% for row in grid_heatmap %}{% for v in row %}{% set _ = flat.append(v) %}{% endfor %}{% endfor %}
    {% set mxv = flat | max %}
    {% set center_val = grid_heatmap[1][1] %}
    {% set corner_avg = (grid_heatmap[0][0] + grid_heatmap[0][2] + grid_heatmap[2][0] + grid_heatmap[2][2]) / 4 %}
    {% set edge_avg = (grid_heatmap[0][1] + grid_heatmap[1][0] + grid_heatmap[1][2] + grid_heatmap[2][1]) / 4 %}

    <!-- Edge activity + Subject placement: equal 1fr 1fr columns so grids are same size -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;align-items:start;">
      <div>
        <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">Edge Activity</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px;">
          {% for row in grid_heatmap %}{% for v in row %}
          <div style="aspect-ratio:1;background:rgba(124,106,247,{{ (v/(mxv+0.001))|round(2) }});border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:0.65rem;color:#e0d8ff;font-weight:500;">{{ "%.2f"|format(v) }}</div>
          {% endfor %}{% endfor %}
        </div>
        <div style="margin-top:0.5rem;font-size:0.75rem;color:#7878a8;line-height:1.5;">Brighter = more edges and detail in that zone. Centre <strong style="color:#c0c0d8;">{{ "%.2f"|format(center_val) }}</strong> vs corners avg <strong style="color:#c0c0d8;">{{ "%.2f"|format(corner_avg) }}</strong>.</div>
      </div>

      {% if saliency_stats and saliency_stats.total_analyzed > 0 %}
      {% set sp = saliency_stats.placement_distribution %}
      {% set sp_flat = [] %}{% for row in sp %}{% for v in row %}{% set _ = sp_flat.append(v) %}{% endfor %}{% endfor %}
      {% set sp_max = sp_flat | max %}
      <div>
        <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">Subject Placement</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px;">
          {% for row in sp %}{% for v in row %}
          <div style="aspect-ratio:1;background:rgba(16,185,129,{{ (v/(sp_max+0.001))|round(2) }});border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:{% if v > sp_max*0.35 %}#d0f5e8{% else %}#2a4a3a{% endif %};">{{ (v*100)|round|int }}%</div>
          {% endfor %}{% endfor %}
        </div>
        <div style="margin-top:0.5rem;font-size:0.75rem;color:#7878a8;line-height:1.5;">Darker green = more images placed in that zone. Subject fills avg <strong style="color:#c0c0d8;">{{ "%.0f"|format((saliency_stats.avg_subject_area or 0)*100) }}%</strong> of the frame; <strong style="color:#c0c0d8;">{{ "%.3f"|format(saliency_stats.avg_off_center or 0) }}</strong> off-centre (0 = perfectly centred).</div>
      </div>
      {% endif %}
    </div>

    <!-- Horizon position -->
    {% set hd = composition_stats.horizon_position_distribution %}
    {% set ht = (hd.high or 0) + (hd.mid or 0) + (hd.low or 0) + (hd.none or 0) %}
    {% if ht > 0 %}
    <div style="margin-bottom:1.1rem;">
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">Horizon Position</div>
      {% for pos, lbl in [("high","Top"),("mid","Mid"),("low","Bottom"),("none","None")] %}
      {% set pct = ((hd[pos] or 0) / ht * 100)|round|int %}
      <div class="dbar">
        <div class="dbar-row"><span>{{ lbl }}</span><span>{{ pct }}%</span></div>
        <div class="dbar-bg"><div class="dbar-fill" style="width:{{ pct }}%;background:#7c6af7;"></div></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <!-- Zone interpretation -->
    <div style="border-top:1px solid #1a1a28;padding-top:0.75rem;">
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.3rem;">Zone Interpretation</div>
      <div style="font-size:0.75rem;color:#7878a8;line-height:1.5;">
        {% if center_val > corner_avg * 1.5 %}
          <strong style="color:#ddd8f0;">Center-dominant</strong> — most visual detail and subject matter sits in the middle of the frame. The centre zone scores <strong style="color:#c0c0d8;">{{ "%.2f"|format(center_val) }}</strong> versus a corner average of <strong style="color:#c0c0d8;">{{ "%.2f"|format(corner_avg) }}</strong>, a ratio typical of telephoto or portrait-heavy libraries.
        {% elif edge_avg > center_val %}
          <strong style="color:#ddd8f0;">Edge-driven</strong> — borders and edges carry more detail than the centre, suggesting wide-angle framing, environmental context, or deliberate use of foreground and leading lines. Edge avg <strong style="color:#c0c0d8;">{{ "%.2f"|format(edge_avg) }}</strong> vs centre <strong style="color:#c0c0d8;">{{ "%.2f"|format(center_val) }}</strong>.
        {% else %}
          <strong style="color:#ddd8f0;">Balanced</strong> — edge activity is spread evenly across all zones with no single area dominating, indicating a varied mix of subject types and framing approaches.
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>

</div>

<!-- Depth strip + Sharpness -->
<div class="row two mb">
  {% if depth_stats and depth_stats.avg_range is not none %}
  <div class="card">
    <div class="card-title">Depth & Spatial Composition <span style="color:#8080aa;font-weight:400;">Depth Anything v2</span></div>
    <div class="strip mb">
      <div class="strip-item">
        <div class="strip-v">{{ "%.3f"|format(depth_stats.avg_range) }}</div>
        <div class="strip-l">Depth Range</div>
        <div class="strip-s">0 flat · 1 full sep.</div>
      </div>
      <div class="strip-item">
        <div class="strip-v">{{ "%.3f"|format(depth_stats.avg_complexity) }}</div>
        <div class="strip-l">Complexity</div>
        <div class="strip-s">std dev of map</div>
      </div>
      <div class="strip-item">
        <div class="strip-v">{{ "%.3f"|format(depth_stats.avg_subject_depth_score) }}</div>
        <div class="strip-l">Subject Score</div>
        <div class="strip-s">center vs edge</div>
      </div>
    </div>
    {% if depth_stats.by_scene %}
    {% set max_dr = depth_stats.by_scene.values() | list | max %}
    <div class="bar-list">
      {% for scene, val in depth_stats.by_scene.items() | sort(attribute='1', reverse=True) %}
      <div class="bar-row">
        <div class="bar-lbl" style="min-width:110px;font-size:0.78rem;text-transform:capitalize;">{{ scene }}</div>
        <div class="bar-track"><div class="bar-fill" style="width:{{ (val/(max_dr+0.001)*100)|int }}%;background:#7c6af7;opacity:0.65;"></div></div>
        <div class="bar-val">{{ "%.3f"|format(val) }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}
  <div class="card">
    <div class="card-title">Sharpness & Exposure</div>
    <div class="strip mb">
      <div class="strip-item">
        {% set sh_avg = sharpness_stats.avg or 0 %}
        <div class="strip-v">{% if sh_avg > 800 %}Very Sharp{% elif sh_avg > 400 %}Sharp{% elif sh_avg > 150 %}Soft{% else %}Blurry{% endif %}</div>
        <div class="strip-l">Avg Sharpness</div>
        <div class="strip-s">score {{ "%.0f"|format(sh_avg) }} · &gt;800 = crisp, &lt;150 = blurry</div>
      </div>
      <div class="strip-item">
        <div class="strip-v">{{ "%+.2f"|format(exposure_stats.avg_bias or 0) }}</div>
        <div class="strip-l">Exposure Bias</div>
        <div class="strip-s">0 = neutral · + = brighter · − = darker</div>
      </div>
      <div class="strip-item">
        <div class="strip-v">{{ "%.1f"|format(exposure_stats.highlight_clipped_pct or 0) }}%</div>
        <div class="strip-l">Highlights Clipped</div>
        <div class="strip-s">images with blown highlights</div>
      </div>
    </div>
    {% if sharpness_stats.by_scene %}
    {% set max_sharp = sharpness_stats.by_scene.values() | list | max %}
    <div class="bar-list">
      {% for scene, val in sharpness_stats.by_scene.items() | sort(attribute='1', reverse=True) %}
      <div class="bar-row">
        <div class="bar-lbl" style="min-width:110px;font-size:0.78rem;text-transform:capitalize;">{{ scene }}</div>
        <div class="bar-track"><div class="bar-fill" style="width:{{ (val/(max_sharp+0.001)*100)|int }}%;background:#10b981;opacity:0.65;"></div></div>
        <div class="bar-val">{{ "%.0f"|format(val) }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>

<!-- Portrait Insights -->
{% if pose_stats and pose_stats.portrait_count >= 20 %}
{% set ft = pose_stats.framing_tiers %}
{% set fa = pose_stats.framing_aesthetic %}
{% set sg = pose_stats.solo_vs_group %}
{% set pcd = pose_stats.person_count_dist %}
<div class="card mb">
  <div class="card-title">Portrait Insights <span style="color:#8080aa;font-weight:400;">{{ pose_stats.portrait_count }} images · YOLOv8-Pose</span></div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start;">
    <!-- Left: stat tiles -->
    <div>
      <div class="stat-grid" style="margin-bottom:0;">
        {% if sg %}
        <div class="stat"><div class="stat-l">Solo</div><div class="stat-v">{{ sg.solo }}</div></div>
        <div class="stat"><div class="stat-l">Group</div><div class="stat-v">{{ sg.group }}</div></div>
        {% endif %}
        {% if pcd %}
        <div class="stat"><div class="stat-l">2-Person</div><div class="stat-v">{{ pcd.get("2", 0) }}</div></div>
        <div class="stat"><div class="stat-l">3-Person</div><div class="stat-v">{{ pcd.get("3", 0) }}</div></div>
        <div class="stat"><div class="stat-l">Group 4+</div><div class="stat-v">{{ pcd.get("4+", 0) }}</div></div>
        {% endif %}
        {% if pose_stats.avg_body_coverage %}
        <div class="stat"><div class="stat-l">Avg Coverage</div><div class="stat-v">{{ (pose_stats.avg_body_coverage * 100) | round(1) }}%</div></div>
        {% endif %}
      </div>
    </div>
    <!-- Right: framing chart -->
    <div>
      {% if ft %}
      <div style="font-size:0.62rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.4rem;">Framing Style <span style="font-weight:400;text-transform:none;color:#5a5a78;">hover for avg aesthetic</span></div>
      <div class="chart-h" style="height:130px;"><canvas id="framingChart"></canvas></div>
      {% endif %}
    </div>
  </div>
</div>
<script>
(() => {
  {% if ft %}
  const elF = document.getElementById("framingChart");
  if (elF) {
    const tiers = {{ ft | tojson }};
    const aesthetic = {{ fa | tojson }};
    new Chart(elF, { type: "bar",
      data: { labels: Object.keys(tiers).map(k => k.charAt(0).toUpperCase()+k.slice(1)), datasets: [{ data: Object.values(tiers), backgroundColor: ["#818cf8bb","#34d399bb","#60a5fabb"], borderRadius: 4 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false },
        tooltip: { callbacks: { afterLabel: ctx => { const k = Object.keys(tiers)[ctx.dataIndex]; return aesthetic[k] != null ? "Avg aesthetic: "+aesthetic[k] : ""; }}}},
        scales: { x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0" }}, y: { grid: { color: "#14142a" }, ticks: { color: "#7878a0" }}}}
    });
  }
  {% endif %}
})();
</script>
{% endif %}

<!-- ══════════════════════════════════════ EDITING STYLE ══════════════════ -->
<div id="s-aesthetics"></div>

<!-- Editing Style Analysis + Aesthetic Quality — side by side -->
<div class="row two mb">
  {% if editing_style_patterns %}
  <div class="card">
    <div class="card-title">Editing Style Analysis</div>
    {% if editing_style_patterns | length == 1 %}
    {% set p = editing_style_patterns[0] %}
    <div class="style-editorial" style="padding:0.75rem 0;">
      <div class="style-name">{{ p.name }}</div>
      <div class="style-conf">{{ "%.0f"|format(p.confidence * 100) }}% confidence · saturation, contrast &amp; brightness variation</div>
      <div class="style-meaning">
        {% if p.key == "varied" or "varied" in p.name.lower() or "eclectic" in p.name.lower() %}
        Your images don't follow a single visual recipe — saturation, contrast, and brightness vary widely.
        This usually means different shoots, different subjects, and multiple creative moods rather than one applied preset.
        It's a sign of range, not inconsistency.
        {% else %}
        {{ p.description }}
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="pattern-grid">
      {% for p in editing_style_patterns %}
      {% set tier = "dom" if p.confidence >= 0.65 else "mod" if p.confidence >= 0.35 else "" %}
      <div class="pattern-card {{ tier }}">
        <div class="ptn-name">{{ p.name }}</div>
        <div class="ptn-conf-row">
          <div class="ptn-conf-bar">
            <div class="ptn-conf-fill" style="width:{{ (p.confidence*100)|int }}%;background:{% if p.confidence>=0.65 %}#7c6af7{% elif p.confidence>=0.35 %}#f97316{% else %}#4b5563{% endif %};"></div>
          </div>
          <div class="ptn-pct">{{ "%.0f"|format(p.confidence*100) }}%</div>
        </div>
        <div class="ptn-desc">{{ p.description }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}
  <div class="card">
    <div class="card-title">Aesthetic Quality <span style="font-weight:400;color:#7878a0;">LAION predictor</span></div>
    <div class="stat-grid" style="margin-bottom:1rem;">
      <div class="stat"><div class="stat-l">Average</div><div class="stat-v">{{ "%.1f"|format(aesthetic_stats.avg_score or 0) }}</div><div class="stat-s">{{ "%.0f"|format(aesthetic_stats.min_score or 0) }}–{{ "%.0f"|format(aesthetic_stats.max_score or 0) }} range · out of 100</div></div>
      <div class="stat"><div class="stat-l">Median</div><div class="stat-v">{{ "%.1f"|format(aesthetic_stats.median_score or 0) }}</div></div>
      <div class="stat"><div class="stat-l">Std Dev</div><div class="stat-v">{{ "%.2f"|format(aesthetic_stats.score_std or 0) }}</div><div class="stat-s">lower = more uniform</div></div>
    </div>
    <div class="range-note">
      {% if aesthetic_stats.score_std and aesthetic_stats.score_std < 2 %}
      Scores cluster tightly (σ={{ "%.2f"|format(aesthetic_stats.score_std) }}) across the {{ "%.0f"|format(aesthetic_stats.min_score or 0) }}–{{ "%.0f"|format(aesthetic_stats.max_score or 0) }} range — the model sees your editing as highly consistent. Scores of 50–65 indicate competently edited photography.
      {% else %}
      Scores of 50–65 indicate well-edited photography. Your avg of {{ "%.1f"|format(aesthetic_stats.avg_score or 0) }} places your library solidly in that bracket.
      {% endif %}
    </div>
  </div>
</div>

{% if false %}<!-- Aesthetic Score by Scene removed — data merged into Color Profile by Scene tiles -->
{% if aesthetic_by_scene %}
{% set aes_sorted = aesthetic_by_scene.items() | sort(attribute='1.avg_score', reverse=True) | list %}
{% set all_scores = aes_sorted | map(attribute='1') | map(attribute='avg_score') | list %}
{% set s_min = all_scores | min %}
{% set s_max = all_scores | max %}
{% set s_range = s_max - s_min %}
{% set s_pad = s_range * 0.3 %}
{% set axis_min = s_min - s_pad %}
{% set axis_max = s_max + s_pad %}
{% set axis_range = axis_max - axis_min %}
{% set max_count = aes_sorted | map(attribute='1') | map(attribute='count') | max %}
{% set sc_colors = ["#7c6af7","#10b981","#f59e0b","#ec4899","#3b82f6","#f97316","#14b8a6","#a855f7","#06b6d4","#ef4444"] %}
<div class="card mb">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
    <div>
      <div class="card-title" style="margin-bottom:0.25rem;">Aesthetic Score by Scene</div>
      <div style="font-size:0.75rem;color:#8080aa;line-height:1.5;">
        Dot position = avg score on a zoomed axis · dot size = image count · shaded band = ±1σ consistency
      </div>
    </div>
    <div style="flex-shrink:0;font-size:0.72rem;color:#7878a0;">{{ "%.1f"|format(s_min) }}–{{ "%.1f"|format(s_max) }} range</div>
  </div>

  <!-- axis tick line -->
  <div style="display:flex;margin-left:168px;margin-right:110px;margin-bottom:2px;">
    <div style="flex:1;display:flex;justify-content:space-between;">
      <span style="font-size:0.6rem;color:#505070;">{{ "%.2f"|format(axis_min) }}</span>
      <span style="font-size:0.6rem;color:#505070;">{{ "%.2f"|format((axis_min + axis_range*0.5)|round(2)) }}</span>
      <span style="font-size:0.6rem;color:#505070;">{{ "%.2f"|format(axis_max) }}</span>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:0.7rem;">
    {% for scene, v in aes_sorted %}{% if v.count > 0 %}
    {% set col = sc_colors[loop.index0 % sc_colors|length] %}
    {% set center_pct = ((v.avg_score - axis_min) / axis_range * 100)|round(2) %}
    {% set band_hw = (v['std'] / axis_range * 100)|round(2) %}
    {% set band_left = (center_pct - band_hw)|round(2) %}
    {% set dot_px = (v.count / max_count * 14 + 7)|round|int %}
    <div style="display:flex;align-items:center;gap:0.6rem;">
      <!-- scene label + count stacked -->
      <div style="min-width:165px;text-align:right;flex-shrink:0;">
        <div style="font-size:0.78rem;color:#c0c0d8;text-transform:capitalize;line-height:1.2;">{{ scene }}</div>
        <div style="font-size:0.62rem;color:#7878a0;">{{ "{:,}".format(v.count) }} images</div>
      </div>
      <!-- dot-plot track -->
      <div style="flex:1;position:relative;height:22px;background:#141420;border-radius:4px;">
        <!-- ±1σ band -->
        <div style="position:absolute;top:50%;transform:translateY(-50%);height:10px;background:{{ col }};opacity:0.15;border-radius:3px;left:{{ [band_left,0]|max }}%;width:{{ [band_hw*2, 100 - [band_left,0]|max]|min }}%;"></div>
        <!-- center line -->
        <div style="position:absolute;top:0;bottom:0;width:1px;background:{{ col }};opacity:0.25;left:{{ center_pct }}%;"></div>
        <!-- dot -->
        <div style="position:absolute;top:50%;transform:translate(-50%,-50%);width:{{ dot_px }}px;height:{{ dot_px }}px;border-radius:50%;background:{{ col }};left:{{ center_pct }}%;box-shadow:0 0 8px {{ col }}55;"></div>
      </div>
      <!-- score value -->
      <div style="min-width:44px;text-align:right;font-size:0.78rem;font-weight:700;color:#e0e0ee;font-variant-numeric:tabular-nums;flex-shrink:0;">{{ "%.2f"|format(v.avg_score) }}</div>
      <!-- std badge -->
      <div style="min-width:52px;font-size:0.68rem;color:#7878a0;flex-shrink:0;">σ&thinsp;{{ "%.2f"|format(v['std']) }}</div>
    </div>
    {% endif %}{% endfor %}
  </div>

  <div style="margin-top:1rem;padding-top:0.75rem;border-top:1px solid #1a1a28;display:flex;gap:1.5rem;flex-wrap:wrap;">
    <div style="font-size:0.72rem;color:#7878a0;line-height:1.6;">
      <strong style="color:#9090b8;">σ (sigma)</strong> = consistency within that scene — lower means your shots in that scene are more uniformly rated. All scenes cluster in the {{ "%.1f"|format(s_min) }}–{{ "%.1f"|format(s_max) }} range on the 0–100 scale, typical for a curated personal library.
    </div>
  </div>
</div>
{% endif %}
{% endif %}

<!-- Color Grading + Color & Mood -->
<div class="row c5-7 mb">
  <div class="card">
    <div class="card-title">Color Grading</div>
    {% set cgs = color_grading_stats %}
    <div class="stat-grid" style="margin-bottom:1rem;grid-template-columns:1fr 1fr;">
      <div class="stat">
        <div class="stat-l">Tonal Style</div>
        <div class="stat-v" style="font-size:0.9rem;text-transform:capitalize;">{{ cgs.tonal_style or "—" }}</div>
        <div class="stat-s">{{ cgs.tonal_description or "" }}</div>
      </div>
      <div class="stat">
        <div class="stat-l">Color Temp.</div>
        <div class="stat-v" style="font-size:0.9rem;text-transform:capitalize;">{{ cgs.color_temperature or "—" }}</div>
        <div class="stat-s">{{ cgs.color_temperature_description or "" }}</div>
      </div>
    </div>
    {% if cgs.avg_tonal_shadow_pct is not none %}
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">Tonal Zone Split</div>
    {% for lbl, val, col in [("Shadows", cgs.avg_tonal_shadow_pct,"#6366f1"),("Midtones",cgs.avg_tonal_mid_pct,"#f59e0b"),("Highlights",cgs.avg_tonal_highlight_pct,"#34d399")] %}
      {% if val is not none %}
      <div class="dbar">
        <div class="dbar-row"><span>{{ lbl }}</span><span>{{ "%.1f"|format(val*100) }}%</span></div>
        <div class="dbar-bg"><div class="dbar-fill" style="width:{{ "%.0f"|format(val*100) }}%;background:{{ col }};"></div></div>
      </div>
      {% endif %}
    {% endfor %}
    {% endif %}
    {% set hps = cgs.harmony_pcts %}
    {% if hps %}
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin:0.9rem 0 0.5rem;">Color Harmony</div>
    {% set hcols = {"analogous":"#7c6af7","complementary":"#f97316","triadic":"#10b981","monochromatic":"#94a3b8","mixed":"#f59e0b"} %}
    {% for htype, pct in hps.items() %}
    <div class="dbar">
      <div class="dbar-row">
        <span style="text-transform:capitalize;">{{ htype }}{% if htype == cgs.dominant_harmony %} <span style="color:#8080aa;">·dom</span>{% endif %}</span>
        <span>{{ pct }}%</span>
      </div>
      <div class="dbar-bg"><div class="dbar-fill" style="width:{{ pct }}%;background:{{ hcols.get(htype,'#4b5563') }};"></div></div>
    </div>
    {% endfor %}
    {% endif %}
    {% set st = cgs.split_toning %}
    {% if st %}
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin:0.9rem 0 0.4rem;">Split Toning</div>
    <div style="font-size:0.82rem;color:#b8b8d0;margin-bottom:0.6rem;">{{ st.toning_style }}</div>
    <div style="display:flex;gap:0.8rem;align-items:flex-start;margin-bottom:0.6rem;">
      {% for zone_label, zone_color, lum_shift in [("Shadows", st.shadow_color, st.shadow_lum_shift), ("Midtones", st.midtone_color, st.midtone_lum_shift), ("Highlights", st.highlight_color, st.highlight_lum_shift)] %}
      <div style="text-align:center;">
        <div style="width:36px;height:36px;border-radius:6px;background:{{ zone_color or '#1e1e2e' }};border:1px solid #2a2a3e;margin:0 auto 4px;" title="{{ zone_label }}{% if lum_shift %} · lum {{ '%+.0f'|format(lum_shift) }}{% endif %}"></div>
        <div style="font-size:0.6rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.05em;">{{ zone_label[:3] }}</div>
        {% if lum_shift and lum_shift|abs > 0.5 %}<div style="font-size:0.6rem;color:{% if lum_shift > 1 %}#34d399{% elif lum_shift < -1 %}#f87171{% else %}#7878a0{% endif %};">{{ '%+.0f'|format(lum_shift) }}</div>{% else %}<div style="font-size:0.6rem;color:#5a5a78;">—</div>{% endif %}
      </div>
      {% endfor %}
      <div style="margin-left:0.4rem;font-size:0.72rem;color:#7878a0;padding-top:4px;">Balance<br><strong style="color:#9090b8;">{{ '%+.0f'|format(st.avg_balance) }}</strong><br><span style="font-size:0.6rem;">−100 shad ↔ +100 hi</span></div>
    </div>
    {% endif %}
  </div>

  <div class="card">
    <div class="card-title">Color &amp; Mood</div>
    {% set palette_colors = [] %}
    {% for photo in photos %}{% if photo.color and photo.color.palette %}{% for sw in photo.color.palette %}{% if palette_colors|length < 40 %}{% set _ = palette_colors.append(sw.rgb) %}{% endif %}{% endfor %}{% endif %}{% endfor %}
    <div class="swatches">{% for rgb in palette_colors %}<div class="swatch" style="background:rgb({{ rgb[0] }},{{ rgb[1] }},{{ rgb[2] }});"></div>{% endfor %}</div>
    <div class="stat-grid" style="margin-bottom:1rem;">
      <div class="stat"><div class="stat-l">Saturation</div><div class="stat-v">{{ "%.2f"|format(color_stats.avg_saturation or 0) }}</div><div class="stat-s">0 grey · 1 vivid</div></div>
      <div class="stat"><div class="stat-l">Sat Std Dev</div><div class="stat-v">{{ "%.3f"|format(color_stats.saturation_std or 0) }}</div></div>
      <div class="stat"><div class="stat-l">Brightness</div><div class="stat-v">{{ "%.2f"|format(color_stats.avg_brightness or 0) }}</div></div>
      <div class="stat"><div class="stat-l">Contrast</div><div class="stat-v">{{ "%.2f"|format(color_stats.avg_contrast or 0) }}</div></div>
    </div>
    {% set wd = color_stats.warmth_distribution %}
    {% set wt = (wd.warm or 0) + (wd.cool or 0) + (wd.neutral or 0) %}
    {% if wt > 0 %}
    {% for tone, col in [("warm","#f97316"),("cool","#38bdf8"),("neutral","#94a3b8")] %}
      {% set pct = ((wd[tone] or 0)/wt*100)|round|int %}
      <div class="dbar">
        <div class="dbar-row"><span>{{ tone|capitalize }}</span><span>{{ pct }}%</span></div>
        <div class="dbar-bg"><div class="dbar-fill" style="width:{{ pct }}%;background:{{ col }};"></div></div>
      </div>
    {% endfor %}
    {% endif %}
    <div style="display:flex;justify-content:space-between;align-items:baseline;margin:0.9rem 0 0.4rem;">
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;">Hue Distribution</div>
      <div style="font-size:0.65rem;color:#606080;">chromatic images only (sat &gt; 15%)</div>
    </div>
    <div class="chart-h" style="max-height:160px;"><canvas id="hueChart" style="max-height:160px;"></canvas></div>
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin:0.8rem 0 0.4rem;">Saturation Distribution</div>
    <div class="chart-h" style="max-height:100px;"><canvas id="satHistChart" style="max-height:100px;"></canvas></div>
  </div>
</div>

<!-- Signature Edit — full width accent -->
{% if signature_edit %}
<div class="card card-purple card-accent-top mb">
  <div class="card-title">Signature Edit</div>
  {% if signature_edit._narrative %}
  <div class="pull">{{ signature_edit._narrative }}</div>
  {% endif %}
  <div class="row two" style="margin-bottom:0;">
    <div>
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.6rem;">Tone</div>
      {% for key in ["Exposure2012","Highlights2012","Shadows2012","Whites2012","Blacks2012","Contrast2012"] %}
      {% set s = signature_edit.get(key) %}{% if s %}
      <div class="sig-row">
        <div class="sig-lbl"><span>{{ key.replace("2012","") }}</span><span>{{ '%+.1f'|format(s.median) }} ±{{ '%.0f'|format(s.std) }}</span></div>
        <div class="sig-track">
          <div class="sig-center"></div>
          {% set norm = s.norm if s.norm is defined else (s.median / 100.0) %}
          {% set bw = ([norm|abs, 1.0]|min) * 50 %}
          {% if norm >= 0 %}<div class="sig-pos" style="left:50%;width:{{ bw }}%;background:#7c6af7;"></div>
          {% else %}<div class="sig-neg" style="width:{{ bw }}%;background:#f97316;"></div>{% endif %}
        </div>
      </div>
      {% endif %}{% endfor %}
    </div>
    <div>
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.6rem;">Presence & Color</div>
      {% for key in ["Texture","Clarity","Dehaze","Vibrance","Saturation"] %}
      {% set s = signature_edit.get(key) %}{% if s %}
      <div class="sig-row">
        <div class="sig-lbl"><span>{{ key }}</span><span>{{ '%+.1f'|format(s.median) }} ±{{ '%.0f'|format(s.std) }}</span></div>
        <div class="sig-track">
          <div class="sig-center"></div>
          {% set norm = s.norm if s.norm is defined else (s.median / 100.0) %}
          {% set bw = ([norm|abs, 1.0]|min) * 50 %}
          {% if norm >= 0 %}<div class="sig-pos" style="left:50%;width:{{ bw }}%;background:#7c6af7;"></div>
          {% else %}<div class="sig-neg" style="width:{{ bw }}%;background:#f97316;"></div>{% endif %}
        </div>
      </div>
      {% endif %}{% endfor %}
      {% set wb = signature_edit.get("WhiteBalance") or signature_edit.get("Temperature") %}{% if wb %}
      <div class="sig-row">
        <div class="sig-lbl"><span>White Balance</span><span>{{ '%.0f'|format(wb.median) }}K · {% if wb.median > 5500 %}warm{% elif wb.median < 4500 %}cool{% else %}neutral{% endif %}</span></div>
        <div class="sig-track">
          <div class="sig-center"></div>
          {% set norm = wb.norm if wb.norm is defined else ((wb.median - 5500) / 3000.0) %}
          {% set bw = ([norm|abs, 1.0]|min) * 50 %}
          {% if norm >= 0 %}<div class="sig-pos" style="left:50%;width:{{ bw }}%;background:#f59e0b;"></div>
          {% else %}<div class="sig-neg" style="width:{{ bw }}%;background:#38bdf8;"></div>{% endif %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

<!-- LR Develop Settings -->
{% if develop_stats and develop_stats.total_with_develop > 0 %}
<div class="card mb">
  <div class="card-title">Lightroom Develop Settings <span style="color:#8080aa;font-weight:400;">{{ develop_stats.total_with_develop }} of {{ photo_count }} images with develop metadata</span></div>
  <div class="card-desc" style="margin-bottom:0.9rem;">Avg slider positions across your library. Only images synced from Lightroom include develop settings — local folder imports don't carry this data. <strong style="color:#9090b8;">Lum. Noise</strong> = Luminance Smoothing, which reduces grain/texture noise in the brightness channel (high-ISO shots). <strong style="color:#9090b8;">Color NR</strong> = Color Noise Reduction, which removes coloured speckles (chroma noise) in shadow areas.</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin-top:4px;">
    {% for key, label in [("Contrast","Contrast"),("Shadows","Shadows"),("Vibrance","Vibrance"),("Saturation","Saturation"),("Sharpness","Sharpness"),("LuminanceSmoothing","Lum. Noise"),("ColorNoiseReduction","Color NR")] %}
    {% set val = develop_stats.avg.get(key) %}{% if val is not none %}
    <div style="background:#16161f;border-radius:7px;padding:10px;">
      <div style="color:#7878a0;font-size:10px;margin-bottom:2px;">{{ label }}</div>
      <div style="font-size:1.1rem;font-weight:700;color:{% if val > 0 %}#34d399{% elif val < 0 %}#f87171{% else %}#9090b8{% endif %};">{% if val > 0 %}+{% endif %}{{ "%.1f"|format(val) }}</div>
      <div style="height:3px;background:#1e1e2e;border-radius:2px;margin-top:6px;">
        {% set p = [(val+100)/200*100,0]|max %}{% set p = [p,100]|min %}
        <div style="width:{{ p|int }}%;height:3px;background:{% if val > 0 %}#34d399{% elif val < 0 %}#f87171{% else %}#9090b8{% endif %};border-radius:2px;"></div>
      </div>
    </div>
    {% endif %}{% endfor %}
  </div>
  {% if develop_stats.by_scene %}
  {% set dev_sliders = [("Exposure2012","Exposure"),("Contrast","Contrast"),("Highlights2012","Highlights"),("Shadows2012","Shadows"),("Whites2012","Whites"),("Blacks2012","Blacks"),("Vibrance","Vibrance"),("Saturation","Saturation"),("Sharpness","Sharpness"),("LuminanceSmoothing","Lum. Noise"),("ColorNoiseReduction","Color NR")] %}
  {% set dev_scenes = develop_stats.by_scene.keys() | list %}
  <div style="margin-top:1.4rem;overflow-x:auto;">
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.6rem;">Avg Slider Value by Scene</div>
    <table style="width:100%;border-collapse:separate;border-spacing:2px;font-size:0.68rem;table-layout:fixed;">
      <colgroup>
        <col style="width:90px;">
        {% for sc in dev_scenes %}<col style="width:{{ (100 / (dev_scenes|length + 0.0001))|round(1) }}%;">{% endfor %}
      </colgroup>
      <thead>
        <tr>
          <th style="text-align:left;padding:3px 8px;color:#7878a0;font-weight:400;"></th>
          {% for sc in dev_scenes %}
          <th style="padding:3px 5px;color:#8080aa;font-weight:400;text-transform:capitalize;font-size:0.62rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ sc.replace(" and ", " & ") }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
      {% for key, label in dev_sliders %}
      {% if develop_stats.avg.get(key) is not none %}
      <tr>
        <td style="padding:3px 8px;color:#9090b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ label }}</td>
        {% for sc in dev_scenes %}
        {% set val = develop_stats.by_scene[sc].get(key) %}
        {% if val is not none %}
        {% set intensity = [(val|abs)/30, 1.0]|min %}
        {% set bg = "rgba(52,211,153," + (intensity*0.75)|round(2)|string + ")" if val > 0 else ("rgba(248,113,113," + (intensity*0.7)|round(2)|string + ")" if val < 0 else "rgba(30,30,46,0.4)") %}
        <td style="text-align:center;padding:4px 6px;background:{{ bg }};border-radius:4px;color:{% if val|abs > 5 %}#e8e8f8{% else %}#7878a0{% endif %};font-variant-numeric:tabular-nums;">{{ "%+.0f"|format(val) }}</td>
        {% else %}
        <td style="text-align:center;padding:4px 6px;color:#303044;font-size:0.6rem;">—</td>
        {% endif %}
        {% endfor %}
      </tr>
      {% endif %}
      {% endfor %}
      </tbody>
    </table>
    <div style="margin-top:0.5rem;font-size:0.68rem;color:#505070;">Green = pushed above default &nbsp;·&nbsp; Red = pulled below &nbsp;·&nbsp; Intensity = magnitude of avg shift</div>
  </div>
  {% endif %}
</div>
{% endif %}

<!-- Editing DNA (HSL fingerprint + intensity) -->
{% if hsl_fingerprint %}
<div class="card mb">
  <div class="card-title">Editing DNA <span style="color:#8080aa;font-weight:400;">HSL channel fingerprint · avg across Lightroom library</span></div>
  <div class="card-desc">How you systematically shift individual colour channels in post — your tonal and colour signature.</div>
  {% set hsl_channels = ["Red","Orange","Yellow","Green","Aqua","Blue","Purple","Magenta"] %}
  {% set ch_colors = {"Red":"#ef4444","Orange":"#f97316","Yellow":"#eab308","Green":"#22c55e","Aqua":"#06b6d4","Blue":"#3b82f6","Purple":"#8b5cf6","Magenta":"#ec4899"} %}
  <!-- column headers -->
  <div style="display:grid;grid-template-columns:80px repeat(3,1fr);gap:3px;margin-bottom:4px;">
    <div></div>
    <div style="text-align:center;font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.06em;">Hue</div>
    <div style="text-align:center;font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.06em;">Sat</div>
    <div style="text-align:center;font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.06em;">Lum</div>
  </div>
  {% for ch in hsl_channels %}
  {% set row = hsl_fingerprint[ch] %}
  <div style="display:grid;grid-template-columns:80px repeat(3,1fr);gap:3px;margin-bottom:3px;align-items:center;">
    <div style="font-size:0.72rem;color:{{ ch_colors[ch] }};font-weight:600;">{{ ch }}</div>
    {% for val, key in [(row.hue_adj,'hue'),(row.sat_adj,'sat'),(row.lum_adj,'lum')] %}
    {% set intensity = [((val|abs)/15), 1.0] | min %}
    {% set bg = "rgba(124,106,247," + (intensity*0.85)|round(2)|string + ")" if val > 0 else ("rgba(239,68,68," + (intensity*0.75)|round(2)|string + ")" if val < 0 else "rgba(30,30,46,0.5)") %}
    <div style="background:{{ bg }};border-radius:4px;padding:3px 5px;text-align:center;font-size:0.72rem;color:{% if val|abs > 3 %}#e8e8f8{% else %}#7878a0{% endif %};">
      {{ "%+.1f"|format(val) }}
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  <div style="margin-top:0.5rem;font-size:0.68rem;color:#5a5a78;">Purple = raised &nbsp;·&nbsp; Red = lowered &nbsp;·&nbsp; Dark = near-zero</div>
</div>
{% endif %}

<!-- Color & Composition by Scene — visual tiles -->
{% if color_by_scene %}
<div class="card mb">
  <div class="card-title">Color Profile, Aesthetic Score &amp; Editing Intensity by Scene</div>
  <div class="color-scene-grid">
    {% set scene_colors_map = {"nature":"#10b981","architecture":"#7c6af7","urban street":"#f97316","people and portraits":"#f59e0b","abstract":"#ec4899","travel and landmarks":"#3b82f6","food":"#ef4444","interior":"#14b8a6","animals":"#a855f7","night scene":"#6366f1","unknown":"#64748b"} %}
    {% for scene, d in color_by_scene.items() | sort(attribute='1.avg_aesthetic', reverse=True) %}
    {% if d.count > 0 %}
    {% set col = scene_colors_map.get(scene, "#7c6af7") %}
    <div class="color-scene-card" style="background:{{ col }}0d;border-color:{{ col }}22;">
      <div class="cs-name">{{ scene }}</div>
      <div class="cs-temp" style="color:{% if d.dominant_warmth=='warm' %}#f97316{% elif d.dominant_warmth=='cool' %}#38bdf8{% else %}#94a3b8{% endif %};">
        {% if d.dominant_warmth == "warm" %}Warm{% elif d.dominant_warmth == "cool" %}Cool{% else %}Neutral{% endif %}
      </div>
      <div style="height:3px;background:{{ col }}33;border-radius:2px;margin:0.4rem 0;">
        <div style="width:{{ ((d.avg_saturation or 0)*100)|int }}%;height:3px;background:{{ col }};border-radius:2px;opacity:0.8;"></div>
      </div>
      <div class="cs-pills">
        {% if d.avg_aesthetic %}<span class="cs-pill" style="color:{{ col }};">⬡ {{ "%.1f"|format(d.avg_aesthetic) }}</span>{% endif %}
        {% if d.aesthetic_std is not none %}<span class="cs-pill">σ {{ "%.2f"|format(d.aesthetic_std) }}</span>{% endif %}
        {% if d.editing_intensity is not none %}<span class="cs-pill">✏ {{ d.editing_intensity|round(0)|int }}</span>{% endif %}
        <span class="cs-pill">sat {{ "%.2f"|format(d.avg_saturation or 0) }}</span>
        <span class="cs-pill">bri {{ "%.2f"|format(d.avg_brightness or 0) }}</span>
        {% if d.avg_contrast is not none %}<span class="cs-pill">con {{ "%.2f"|format(d.avg_contrast) }}</span>{% endif %}
        <span class="cs-pill">{{ d.count }} images</span>
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
  <div style="margin-top:0.75rem;font-size:0.68rem;color:#5a5a78;">⬡ = avg aesthetic score · σ = consistency (lower = more uniform) · ✏ = editing intensity (sum of Lr slider deviations)</div>
</div>
{% endif %}

<!-- Editing Trends -->
{% if editing_trends and editing_trends|length > 1 %}
<div class="card mb">
  <div class="card-title">Editing Trends Over Time</div>
  <div class="chart-h"><canvas id="trendsChart"></canvas></div>
</div>
{% endif %}

<!-- Portfolio Albums (moved before WHEN YOU SHOOT) -->
{% if album_stats and album_stats.total_albums > 0 %}
<div class="card mb">
  <div class="card-title">Portfolio Albums <span style="color:#8080aa;font-weight:400;">Lightroom collections · curated selections</span></div>
  <div class="card-desc">Images you've placed in albums represent your curated portfolio — the subset you've actively chosen to showcase. Comparing album images against the rest of your library shows how well the AI aesthetic model aligns with your own taste.</div>
  <div class="strip mb">
    <div class="strip-item">
      <div class="strip-v">{{ album_stats.total_albums }}</div>
      <div class="strip-l">Albums</div>
      <div class="strip-s">Lightroom collections</div>
    </div>
    <div class="strip-item">
      <div class="strip-v">{{ album_stats.total_in_albums }}</div>
      <div class="strip-l">Curated Images</div>
      <div class="strip-s">of {{ album_stats.total_trackable }} Lightroom images</div>
    </div>
    <div class="strip-item">
      <div class="strip-v" style="color:#7c6af7;">{{ album_stats.curation_rate }}%</div>
