<script>
function _hueToggle(btn) {
  const wrap = document.getElementById('hue-collapsible');
  const expanded = wrap.style.maxHeight !== '0px' && wrap.style.maxHeight !== '0';
  wrap.style.maxHeight = expanded ? '0' : 'none';
  btn.textContent = expanded ? 'Hue & Saturation ↓' : 'Hue & Saturation ↑';
  // Trigger Chart.js resize so hueChart renders correctly after expand
  if (!expanded) setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 50);
}

function _gearToggle(btn) {
  const wrap = btn.previousElementSibling;
  const collapsed = wrap.style.maxHeight !== 'none';
  if (collapsed) {
    wrap.dataset.collapsedH = wrap.style.maxHeight;
    wrap.style.maxHeight = 'none';
    btn.textContent = 'Show less ↑';
  } else {
    wrap.style.maxHeight = wrap.dataset.collapsedH || '200px';
    btn.textContent = 'Show all ↓';
  }
}
document.addEventListener('DOMContentLoaded', function() {
  // Sync lens collapsible height to motion style column height
  const lensWrap = document.getElementById('lens-collapsible');
  const motionCol = document.getElementById('motion-style-col');
  if (lensWrap && motionCol) {
    const h = motionCol.scrollHeight;
    lensWrap.style.maxHeight = h + 'px';
  }
  // Hide expand button when content already fits
  document.querySelectorAll('.expand-btn').forEach(function(btn) {
    const wrap = btn.previousElementSibling;
    if (!wrap) return;
    const cap = parseInt(wrap.style.maxHeight) || 200;
    if (wrap.scrollHeight <= cap + 4) btn.style.display = 'none';
  });
});

const SC = ["#f87171","#fb923c","#fbbf24","#a3e635","#4ade80","#34d399","#22d3ee","#60a5fa","#818cf8","#e879f9","#f472b6","#38bdf8"];
const GD = { responsive: true, plugins: { legend: { display: false } }, scales: {
  x: { grid: { color: "#14142a" }, ticks: { color: "#8080aa", font: { size: 13 } } },
  y: { grid: { color: "#14142a" }, ticks: { color: "#8080aa", font: { size: 13 } } },
}};


// UMAP — colored by DINOv3 cluster (visual similarity groups, no scene labels)
(function() {
  const pts = {{ umap_points | tojson }};
  if (!pts.length) return;

  const umapWrap = document.getElementById("umapChart").parentElement;
  umapWrap.style.position = "relative";
  const tip = document.createElement("div");
  tip.style.cssText = "position:absolute;pointer-events:none;display:none;background:#10101a;border:1px solid #2a2a3a;border-radius:8px;padding:8px;z-index:10;box-shadow:0 4px 16px #00000088;min-width:100px;text-align:center;";
  umapWrap.appendChild(tip);

  const ds = {};
  pts.forEach(p => {
    const k = p.cluster ?? 0;
    if (!ds[k]) ds[k] = { label: "cluster " + (k + 1), data: [], backgroundColor: SC[k % SC.length] + "99", pointRadius: 3, pointHoverRadius: 6 };
    ds[k].data.push({ x: p.x, y: p.y, score: p.aesthetic_score, thumb: p.thumb, exif: p.exif || {} });
  });

  new Chart(document.getElementById("umapChart"), {
    type: "scatter",
    data: { datasets: Object.values(ds).sort((a, b) => a.label.localeCompare(b.label)) },
    options: { responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { enabled: false, external: (ctx) => {
          const el = ctx.chart.canvas;
          if (!ctx.tooltip.dataPoints || !ctx.tooltip.dataPoints.length) { tip.style.display = "none"; return; }
          const d = ctx.tooltip.dataPoints[0].raw;
          const ex = d.exif || {};
          while (tip.firstChild) tip.removeChild(tip.firstChild);
          if (d.thumb) {
            const img = document.createElement("img");
            img.src = "data:image/jpeg;base64," + d.thumb;
            img.style.cssText = "width:72px;height:72px;object-fit:cover;border-radius:5px;display:block;margin:0 auto 5px;";
            tip.appendChild(img);
          }
          if (d.score != null) {
            const sc = document.createElement("div");
            sc.textContent = "Aesthetic " + d.score.toFixed(1);
            sc.style.cssText = "font-size:11px;color:#a78bfa;font-weight:600;margin-bottom:3px;";
            tip.appendChild(sc);
          }
          const exifParts = [];
          if (ex.focal_length_mm) exifParts.push(ex.focal_length_mm + "mm");
          if (ex.aperture_f) exifParts.push("f/" + ex.aperture_f);
          if (ex.iso) exifParts.push("ISO " + ex.iso);
          if (exifParts.length) {
            const exd = document.createElement("div");
            exd.textContent = exifParts.join(" · ");
            exd.style.cssText = "font-size:10px;color:#7878a0;";
            tip.appendChild(exd);
          }
          tip.style.display = "block";
          const tipW = 110, tipH = d.thumb ? 140 : 70;
          let left = ctx.tooltip.caretX + 10, top = ctx.tooltip.caretY - tipH / 2;
          if (left + tipW > el.offsetWidth) left = ctx.tooltip.caretX - tipW - 10;
          top = Math.max(0, Math.min(top, el.offsetHeight - tipH));
          tip.style.left = left + "px"; tip.style.top = top + "px";
        }}
      },
      scales: { x: { grid: { color: "#14142a" }, ticks: { display: false } }, y: { grid: { color: "#14142a" }, ticks: { display: false } } }
    }
  });
  document.getElementById("umapChart").addEventListener("mouseleave", () => { tip.style.display = "none"; });
})();

// Shared bar-label plugin — draws count above each vertical bar
const _vBarLabels = {
  id: 'vBarLabels',
  afterDatasetsDraw(chart) {
    const ctx = chart.ctx;
    chart.data.datasets.forEach((ds, i) => {
      chart.getDatasetMeta(i).data.forEach((bar, idx) => {
        const val = ds.data[idx];
        if (!val) return;
        ctx.save();
        ctx.fillStyle = '#9090b8';
        ctx.font = '10px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'bottom';
        ctx.fillText(val, bar.x, bar.y - 3);
        ctx.restore();
      });
    });
  }
};



