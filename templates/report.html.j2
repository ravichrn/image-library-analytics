// Editing trends — % change over time (single y-axis, all metrics comparable)
(function() {
  const trends = {{ editing_trends | tojson }};
  const months = Object.keys(trends).sort();
  if (months.length < 2) return;

  // Compute % change relative to the first non-null value for a given key.
  // Returns null for months with no data or for the baseline month (shown as 0).
  function pctChange(key) {
    const raw = months.map(m => trends[m][key] ?? null);
    const firstIdx = raw.findIndex(v => v !== null && v !== 0);
    if (firstIdx < 0) return raw.map(() => null);
    const base = raw[firstIdx];
    return raw.map((v, i) => {
      if (v === null || v === 0) return null;
      if (i < firstIdx) return null;
      return Math.round((v - base) / base * 1000) / 10; // 1 decimal place
    });
  }

  const aesData = pctChange("avg_aesthetic");
  const iqData  = pctChange("avg_iq");
  const intData = pctChange("avg_edit_intensity");

  const hasIQ  = iqData.some(v => v !== null);
  const hasInt = intData.some(v => v !== null);

  const datasets = [
    { label: "Aesthetic %Δ", data: aesData, borderColor: "#7c6af7", backgroundColor: "#7c6af715",
      tension: 0.3, fill: true, pointRadius: 3, spanGaps: true },
  ];
  if (hasIQ)  datasets.push({ label: "IQ %Δ",        data: iqData,  borderColor: "#10b981", tension: 0.3, pointRadius: 2, borderDash: [4,3], spanGaps: true });
  if (hasInt) datasets.push({ label: "Intensity %Δ", data: intData, borderColor: "#f97316", tension: 0.3, pointRadius: 2, borderDash: [6,3], spanGaps: true });

  new Chart(document.getElementById("trendsChart"), {
    type: "line",
    data: { labels: months, datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: "index", intersect: false },
      plugins: {
        legend: { display: true, labels: { color: "#5a5a78", boxWidth: 12, font: { size: 11 } }},
        tooltip: { callbacks: { label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y != null ? (ctx.parsed.y > 0 ? "+" : "") + ctx.parsed.y.toFixed(1) + "%" : "—"}` }},
      },
      scales: {
        x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", maxRotation: 45 }},
        y: { grid: { color: "#14142a" },
             ticks: { color: "#7878a0", callback: v => (v > 0 ? "+" : "") + v + "%" },
             title: { display: true, text: "% change from baseline", color: "#7878a0", font: { size: 10 }}},
      }
    }
  });
})();


// Editing Journey multi-line chart — % change from each slider's first non-zero value
{% if _sources.has_lightroom and editing_journey and editing_journey|length > 1 %}
(function() {
  const ej = {{ editing_journey | tojson }};
  const months = Object.keys(ej).sort();
  const elJ = document.getElementById("editingJourneyChart");
  if (!elJ) return;

  const _ejAllParams = {
    Exposure2012:   { label: "Exposure",   color: "#f59e0b" },
    Highlights2012: { label: "Highlights", color: "#34d399" },
    Shadows2012:    { label: "Shadows",    color: "#818cf8" },
    Whites2012:     { label: "Whites",     color: "#e2e8f0" },
    Blacks2012:     { label: "Blacks",     color: "#64748b" },
    Contrast2012:   { label: "Contrast",   color: "#fb923c" },
    Clarity2012:    { label: "Clarity",    color: "#7c6af7" },
    Texture:        { label: "Texture",    color: "#60a5fa" },
    Dehaze:         { label: "Dehaze",     color: "#a78bfa" },
    Saturation:     { label: "Saturation", color: "#f97316" },
    Vibrance:       { label: "Vibrance",   color: "#10b981" },
    GrainAmount:    { label: "Grain",      color: "#9090b8" },
  };
  const _ejActive = new Set(["Exposure2012", "Highlights2012", "Whites2012", "Blacks2012", "Contrast2012"]);

  let _ejMode = "z"; // "z" = z-score (normalized), "raw" = actual slider values

  // ── Z-score: centers each slider on its own mean, scales by its own std ──
  // All sliders land on the same σ axis — directly comparable regardless of
  // absolute magnitude. 0 = your average for that slider, ±1 = 1 std dev.
  // Handles near-constant sliders (std ≈ 0) by returning all-zero.
  function ejZScore(key) {
    const raw = months.map(m => (ej[m] != null && ej[m][key] != null) ? ej[m][key] : null);
    const valid = raw.filter(v => v !== null);
    if (valid.length < 2) return raw.map(() => null);
    const mean = valid.reduce((a, b) => a + b, 0) / valid.length;
    const variance = valid.reduce((s, v) => s + (v - mean) ** 2, 0) / valid.length;
    const std = Math.sqrt(variance);
    if (std < 0.01) return raw.map(v => v !== null ? 0 : null); // constant slider
    return raw.map(v => v !== null ? Math.round((v - mean) / std * 100) / 100 : null);
  }

  // ── Raw: actual slider values (useful for studying a single slider) ───────
  function ejRaw(key) {
    return months.map(m => (ej[m] != null && ej[m][key] != null) ? ej[m][key] : null);
  }

  function _ejBuildDatasets() {
    const useFn = _ejMode === "z" ? ejZScore : ejRaw;
    const suffix = _ejMode === "z" ? " σ" : "";
    return Object.entries(_ejAllParams)
      .filter(([k]) => _ejActive.has(k))
      .map(([k, cfg]) => ({
        label: cfg.label + suffix,
        data: useFn(k),
        borderColor: cfg.color,
        tension: 0.3,
        yAxisID: "y",
        pointRadius: 2,
        spanGaps: false,
      }));
  }

  function _ejScaleConfig() {
    if (_ejMode === "z") {
      return {
        grid: { color: "#14142a" },
        ticks: { color: "#7878a0", callback: v => (v > 0 ? "+" : "") + v + "σ" },
        title: { display: true, text: "std deviations from your avg (σ)", color: "#7878a0", font: { size: 9 }},
      };
    }
    return {
      grid: { color: "#14142a" },
      ticks: { color: "#7878a0", callback: v => (v > 0 ? "+" : "") + v },
      title: { display: true, text: "Slider value", color: "#7878a0", font: { size: 9 }},
    };
  }

  function _ejTooltipLabel(ctx) {
    if (ctx.parsed.y == null) return ` ${ctx.dataset.label}: —`;
    const val = ctx.parsed.y;
    const suffix = _ejMode === "z"
      ? (val > 0 ? "+" : "") + val.toFixed(2) + "σ"
      : (val > 0 ? "+" : "") + val.toFixed(1);
    return ` ${ctx.dataset.label}: ${suffix}`;
  }

  const _ejChart = new Chart(elJ, {
    type: "line",
    data: { labels: months, datasets: _ejBuildDatasets() },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: "index", intersect: false },
      plugins: {
        legend: { display: true, labels: { color: "#5a5a78", boxWidth: 10, font: { size: 10 } }},
        tooltip: { callbacks: { label: _ejTooltipLabel }},
      },
      scales: { x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", maxRotation: 45, font: { size: 9 }}}, y: _ejScaleConfig() }
    }
  });

  window.ejSetMode = function(mode) {
    _ejMode = mode;
    const btnZ   = document.getElementById("ejModeZ");
    const btnRaw = document.getElementById("ejModeRaw");
    if (mode === "z") {
      btnZ.style.background   = "#7c6af722"; btnZ.style.color   = "#7c6af7"; btnZ.style.fontWeight = "600";
      btnRaw.style.background = "transparent"; btnRaw.style.color = "#5a5a78"; btnRaw.style.fontWeight = "400";
    } else {
      btnRaw.style.background = "#7c6af722"; btnRaw.style.color  = "#7c6af7"; btnRaw.style.fontWeight = "600";
      btnZ.style.background   = "transparent"; btnZ.style.color  = "#5a5a78"; btnZ.style.fontWeight  = "400";
    }
    _ejChart.data.datasets = _ejBuildDatasets();
    _ejChart.options.scales.y = _ejScaleConfig();
    _ejChart.update();
  };

  window.ejToggle = function(btn) {
    const key = btn.dataset.ejKey;
    const col = btn.dataset.ejCol;
    if (_ejActive.has(key)) {
      _ejActive.delete(key);
      btn.style.background = "transparent";
      btn.style.opacity = "0.45";
    } else {
      _ejActive.add(key);
      btn.style.background = col + "22";
      btn.style.opacity = "1";
    }
    _ejChart.data.datasets = _ejBuildDatasets();
    _ejChart.update();
  };

  const elA = document.getElementById("adoptionChart");
  if (elA) {
    new Chart(elA, {
      type: "line",
      data: { labels: months, datasets: [
        { label: "Toning %", data: months.map(m=>ej[m].toning_pct), borderColor: "#7c6af7", backgroundColor: "#7c6af718", tension: 0.3, pointRadius: 2, fill: false },
        { label: "Crop %", data: months.map(m=>ej[m].crop_pct), borderColor: "#f97316", tension: 0.3, pointRadius: 2, fill: false },
        { label: "Custom Curve %", data: months.map(m=>ej[m].custom_curve_pct), borderColor: "#10b981", tension: 0.3, pointRadius: 2, fill: false },
        { label: "Auto WB %", data: months.map(m=>ej[m].auto_wb_pct), borderColor: "#f59e0b", tension: 0.3, pointRadius: 2, fill: false },
        { label: "Automation %", data: months.map(m=>(ej[m].automation_score||0)*100), borderColor: "#94a3b8", tension: 0.3, pointRadius: 2, fill: false, borderDash: [4,3] },
      ]},
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: "index", intersect: false },
        plugins: { legend: { display: true, labels: { color: "#5a5a78", boxWidth: 10, font: { size: 10 }}}},
        scales: { x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", font: { size: 9 }, maxRotation: 45 }}, y: { grid: { color: "#14142a" }, ticks: { color: "#7878a0" }, min: 0, max: 100, title: { display: true, text: "%", color: "#9090b8", font: { size: 9 }}}}}
    });
  }
})();
{% endif %}

