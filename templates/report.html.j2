<button id="back-to-top" aria-label="Back to top">↑</button>

<script>
(function() {
  const sbLinks = Array.from(document.querySelectorAll("#sidebar a"));
  const targets = sbLinks.map(a => document.querySelector(a.getAttribute("href")));
  function update() {
    let current = 0;
    targets.forEach((el, i) => { if (el && el.getBoundingClientRect().top <= 90) current = i; });
    sbLinks.forEach((a, i) => a.classList.toggle("sb-active", i === current));
  }
  window.addEventListener("scroll", update, { passive: true });
  // Deep links: update URL hash as user scrolls
  window.addEventListener("scroll", function () {
    let current = null;
    targets.forEach((el, i) => { if (el && el.getBoundingClientRect().top <= 90) current = sbLinks[i]; });
    if (current) {
      const href = current.getAttribute("href");
      if (href && location.hash !== href) history.replaceState(null, "", href);
    }
  }, { passive: true });
  // On load: scroll to hash if present
  const _initHash = location.hash;
  if (_initHash) {
    const _target = document.querySelector(_initHash);
    if (_target) setTimeout(() => _target.scrollIntoView({ behavior: "smooth" }), 80);
  }
  update();
})();

(function () {
  const btn = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    btn.classList.toggle('visible', window.scrollY / document.body.scrollHeight > 0.15);
  }, { passive: true });
  btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
})();
</script>

