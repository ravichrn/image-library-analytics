<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>On-Device Image Analytics</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root {
  --fs-card-title: 0.76rem;
  --fs-card-desc:  0.86rem;
  --fs-label:      0.78rem;
  --fs-body:       0.83rem;
  --fs-sub:        0.75rem;
  --fs-micro:      0.66rem;
  --fs-stat-v:     1.3rem;
  --fs-strip-v:    1.2rem;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #09090e;
  color: #d8d8e4;
  line-height: 1.65;
  font-size: 15px;
  display: flex;
}
#sidebar {
  width: 180px; min-width: 180px; position: sticky; top: 0; height: 100vh;
  overflow-y: auto; background: #0c0c14; border-right: 1px solid #1a1a2e;
  padding: 1.2rem 0; flex-shrink: 0; z-index: 100;
}
#sidebar .sb-logo { font-size: 0.6rem; font-weight: 800; color: #7c6af7; text-transform: uppercase;
  letter-spacing: 0.14em; padding: 0 1.2rem 1.2rem; border-bottom: 1px solid #1a1a2e; margin-bottom: 0.6rem; }
#sidebar .sb-label { font-size: 0.58rem; color: #3a3a5a; text-transform: uppercase;
  letter-spacing: 0.1em; padding: 0.9rem 1.2rem 0.3rem; }
#sidebar a { display: block; font-size: 0.76rem; color: #7878a0; padding: 0.42rem 1.2rem;
  text-decoration: none; border-left: 2px solid transparent; transition: color 0.12s, border-color 0.12s; }
#sidebar a:hover { color: #b8b8d0; border-left-color: #4a4a7a; }
#sidebar a.sb-active { color: #c8c8de; border-left-color: #7c6af7; }
#main-content { flex: 1; min-width: 0; }
.page { max-width: 1160px; margin: 0 auto; padding: 0 1.5rem 6rem; }
@media (max-width: 900px) {
  body { display: block; }
  #sidebar { display: none; }
  #sidebar.open { display: block; position: fixed; top: 0; left: 0; width: 220px; height: 100vh; z-index: 200; box-shadow: 4px 0 20px rgba(0,0,0,0.6); }
  #hamburger { display: flex; align-items: center; justify-content: center; position: fixed; top: 0.75rem; left: 0.75rem; z-index: 201; background: #0c0c14; border: 1px solid #2a2a3f; border-radius: 6px; width: 2.2rem; height: 2.2rem; cursor: pointer; font-size: 1rem; color: #7c6af7; }
  .row.three { grid-template-columns: 1fr !important; }
  .row.two { grid-template-columns: 1fr !important; }
  #sidebar-overlay { display: none; position: fixed; inset: 0; z-index: 199; background: rgba(0,0,0,0.5); }
  #sidebar-overlay.open { display: block; }
}
@media (min-width: 901px) { #hamburger { display: none; } #sidebar-overlay { display: none !important; } }

/* ── Hero ──────────────────────────────────────────────────────── */
.hero {
  padding: 2rem 0 1.5rem;
  border-bottom: 1px solid #17172a;
  margin-bottom: 1.5rem;
}
.hero-label {
  font-size: 0.65rem; color: #7878a0; text-transform: uppercase;
  letter-spacing: 0.18em; font-weight: 600; margin-bottom: 0.6rem;
}
.hero-title {
  font-size: 3.5rem; font-weight: 900; letter-spacing: -0.04em;
  color: #fff; line-height: 1.0; margin-bottom: 0.5rem;
}
.hero-sub {
  font-size: 0.82rem; color: #8080aa;
  margin-bottom: 0.6rem;
}
.hero-digest {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 0;
  border: 1px solid #17172a;
  border-radius: 12px;
  overflow: hidden;
}
.hero-digest-item {
  padding: 1.1rem 1.4rem;
  border-right: 1px solid #17172a;
}
.hero-digest-item:last-child { border-right: none; }
.hd-label { font-size: 0.72rem; color: #8080aa; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
.hd-value { font-size: 1.15rem; font-weight: 700; color: #e0e0ee; }
.hd-sub { font-size: 0.72rem; color: #7878a0; margin-top: 0.18rem; }

/* ── Section title ─────────────────────────────────────────────── */
.s-title {
  font-size: 0.62rem; font-weight: 700; color: #7878a0;
  text-transform: uppercase; letter-spacing: 0.14em;
  margin-bottom: 0.75rem;
}

/* ── Base card ─────────────────────────────────────────────────── */
.card {
  background: #111118;
  border: 1px solid #1c1c2e;
  border-radius: 14px;
  padding: 1.4rem 1.6rem;
}
.card-title {
  font-size: var(--fs-card-title); font-weight: 700; color: #7878a0;
  text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.8rem;
}
.card-title span { font-size: var(--fs-micro); font-weight: 400; }
.card-desc { font-size: var(--fs-card-desc); color: #7878a8; margin-top: -0.3rem; margin-bottom: 0.9rem; line-height: 1.55; }
.naked { background: transparent; border-color: transparent; padding: 0; }

/* ── Accent cards ──────────────────────────────────────────────── */
.card-accent-top { border-top: 2px solid #7c6af7; }
.card-warm { background: #130f0a; border-color: #2a1e10; }
.card-purple { background: #0f0d1f; border-color: #1e1a3a; }

/* ── Layout ────────────────────────────────────────────────────── */
.row { display: grid; gap: 1rem; margin-bottom: 1rem; }
.two   { grid-template-columns: 1fr 1fr; }
.three { grid-template-columns: 1fr 1fr 1fr; }
.c3-2  { grid-template-columns: 3fr 2fr; }
.c2-3  { grid-template-columns: 2fr 3fr; }
.c4-8  { grid-template-columns: 4fr 8fr; }
.c5-7  { grid-template-columns: 5fr 7fr; }
.c7-5  { grid-template-columns: 7fr 5fr; }
@media (max-width: 780px) {
  .two, .three, .c3-2, .c2-3, .c4-8, .c5-7, .c7-5 { grid-template-columns: 1fr; }
  #color-board-inner { grid-template-columns: 1fr !important; }
}
.mb { margin-bottom: 1rem; }

/* ── Stats ─────────────────────────────────────────────────────── */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px,1fr)); gap: 0.75rem; }
.stat { background: #16161f; border-radius: 8px; padding: 0.85rem 1rem; }
.stat-l { font-size: var(--fs-sub); color: #8080aa; text-transform: uppercase; letter-spacing: 0.06em; }
.stat-v { font-size: var(--fs-stat-v); font-weight: 700; color: #ddd8f0; margin-top: 0.15rem; }
.stat-s { font-size: var(--fs-sub); color: #7878a0; margin-top: 0.1rem; }
.stat-u { font-size: 0.6em; color: #8080aa; font-weight: 400; margin-left: 1px; }

/* Inline strip */
.strip { display: flex; border: 1px solid #1c1c2e; border-radius: 10px; overflow: hidden; }
.strip-item { flex: 1; padding: 0.85rem 1.1rem; border-right: 1px solid #1c1c2e; }
.strip-item:last-child { border-right: none; }
.strip-v { font-size: var(--fs-strip-v); font-weight: 700; color: #ddd8f0; }
.strip-l { font-size: var(--fs-sub); color: #8080a8; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.12rem; }
.strip-s { font-size: var(--fs-sub); color: #7878a0; margin-top: 0.08rem; }

/* ── Bar lists ─────────────────────────────────────────────────── */
.bar-list { display: flex; flex-direction: column; gap: 0.45rem; }
.bar-row { display: flex; align-items: center; gap: 0.65rem; }
.bar-lbl { font-size: var(--fs-body); color: #8888aa; text-align: right; flex-shrink: 0; min-width: 0; }
.bar-track { flex: 1; height: 7px; background: #1a1a28; border-radius: 4px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 4px; }
.bar-val { font-size: var(--fs-sub); color: #7878a8; min-width: 42px; text-align: right; flex-shrink: 0; }

/* ── Small bar (dist) ───────────────────────────────────────────── */
.dbar { margin-bottom: 0.45rem; }
.dbar-row { display: flex; justify-content: space-between; font-size: var(--fs-body); margin-bottom: 3px; }
.dbar-row span:first-child { color: #8888aa; }
.dbar-row span:last-child { color: #7878a8; }
.dbar-bg { height: 5px; background: #1a1a28; border-radius: 3px; }
.dbar-fill { height: 5px; border-radius: 3px; }

/* ── Table ─────────────────────────────────────────────────────── */
table { width: 100%; border-collapse: collapse; font-size: var(--fs-body); }
th { text-align: left; color: #7878a8; font-weight: 600; padding: 0.35rem 0.8rem;
     border-bottom: 1px solid #1c1c2e; text-transform: uppercase; font-size: var(--fs-sub); letter-spacing: 0.06em; }
td { padding: 0.5rem 0.8rem; border-bottom: 1px solid #141420; color: #9090b8; }
tr:last-child td { border-bottom: none; }
.badge { display: inline-block; background: #1c1c2e; border-radius: 4px; padding: 3px 8px; font-size: var(--fs-label); margin: 2px; color: #6a6a90; }

/* ── Collapsible section arrow ─────────────────────────────────── */
.section-summary::after { content: "▾"; margin-left: auto; font-size: 0.75rem; transition: transform 0.2s; }
details:not([open]) .section-summary::after { transform: rotate(-90deg); }

/* ── Chart wraps ───────────────────────────────────────────────── */
.chart-h { position: relative; }
canvas { max-height: 300px; }

/* ── Swatches ──────────────────────────────────────────────────── */
.swatches { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 1rem; }
.swatch { width: 28px; height: 28px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.04); }

/* ── Composition patterns ──────────────────────────────────────── */
.cp-list { display: flex; flex-direction: column; gap: 0.45rem; }
.cp-row { display: flex; align-items: flex-start; gap: 0.6rem; }
.cp-pct { font-size: 0.73rem; font-weight: 700; min-width: 35px; text-align: right; color: #606088; flex-shrink: 0; padding-top: 1px; }
.cp-name { font-size: var(--fs-body); color: #c0c0d8; font-weight: 600; }
.cp-desc { font-size: var(--fs-sub); color: #7878a8; line-height: 1.45; margin-top: 2px; }
.cp-bar { height: 3px; background: #1a1a28; border-radius: 2px; margin-top: 4px; }
.cp-bar-fill { height: 3px; border-radius: 2px; background: #10b981; }

/* ── Grid heatmap ──────────────────────────────────────────────── */
.heatmap { display: grid; grid-template-columns: repeat(3,1fr); gap: 3px; max-width: 180px; }
.hm-cell { aspect-ratio: 1; border-radius: 3px; display: flex; align-items: center; justify-content: center;
           font-size: 0.63rem; font-weight: 600; color: rgba(255,255,255,0.55); }

/* ── Sig bars ──────────────────────────────────────────────────── */
.sig-row { margin-bottom: 6px; }
.sig-lbl { display: flex; justify-content: space-between; font-size: 0.78rem; margin-bottom: 3px; }
.sig-lbl span:first-child { color: #9090b8; }
.sig-lbl span:last-child { color: #7878a8; }
.sig-track { position: relative; height: 5px; background: #1a1a28; border-radius: 3px; }
.sig-center { position: absolute; left: 50%; top: 0; width: 1px; height: 100%; background: #2a2a3e; }
.sig-pos { position: absolute; top: 0; height: 100%; border-radius: 0 3px 3px 0; }
.sig-neg { position: absolute; top: 0; height: 100%; border-radius: 3px 0 0 3px; right: 50%; }

/* ── Pull quote ────────────────────────────────────────────────── */
.pull {
  font-style: italic; color: #9090b8; font-size: 0.85rem; line-height: 1.75;
  border-left: 2px solid #7c6af7; padding: 0.55rem 1rem 0.55rem 1rem;
  background: #0f0d1e; border-radius: 0 8px 8px 0; margin-bottom: 1.4rem;
}

/* ── Editing style editorial ────────────────────────────────────── */
.style-editorial {
  display: flex; flex-direction: column; justify-content: center;
  padding: 1.5rem 0;
}
.style-name {
  font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em;
  color: #7c6af7; line-height: 1.1; margin-bottom: 0.35rem;
}
.style-conf { font-size: var(--fs-sub); color: #8080aa; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
.style-meaning { font-size: var(--fs-body); color: #8080a8; line-height: 1.65; max-width: 520px; }

/* ── Scene tiles ────────────────────────────────────────────────── */
.scene-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.75rem; }
.scene-tile {
  background: #111118; border: 1px solid #1c1c2e; border-radius: 10px;
  padding: 1rem 1.1rem; position: relative; overflow: hidden;
}
.scene-tile::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
}
.scene-tile-name { font-size: var(--fs-body); color: #9090b0; font-weight: 600; margin-bottom: 0.4rem; text-transform: capitalize; }
.scene-tile-count { font-size: 1.6rem; font-weight: 800; color: #e0e0ee; letter-spacing: -0.02em; line-height: 1; }
.scene-tile-score { font-size: var(--fs-label); color: #7878a0; margin-top: 0.25rem; }
.scene-tile-bar { height: 3px; background: #1a1a28; border-radius: 2px; margin-top: 0.6rem; }
.scene-tile-bar-fill { height: 3px; border-radius: 2px; }

/* ── Aesthetic score by scene ───────────────────────────────────── */
.aes-scene-list { display: flex; flex-direction: column; gap: 0.55rem; }
.aes-scene-row { display: flex; align-items: center; gap: 0.75rem; }
.aes-scene-name { font-size: var(--fs-body); color: #8888aa; min-width: 140px; text-align: right; flex-shrink: 0; text-transform: capitalize; }
.aes-scene-bar-wrap { flex: 1; position: relative; height: 20px; background: #141420; border-radius: 5px; overflow: hidden; }
.aes-scene-bar-fill { height: 100%; border-radius: 5px; display: flex; align-items: center; padding-left: 8px; }
.aes-scene-score { font-size: var(--fs-label); font-weight: 700; color: rgba(255,255,255,0.8); white-space: nowrap; }
.aes-scene-count { font-size: var(--fs-label); color: #7878a0; min-width: 60px; text-align: left; }

/* ── Color scene cards ──────────────────────────────────────────── */
.color-scene-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px,1fr)); gap: 0.65rem; }
.color-scene-card {
  border-radius: 9px; padding: 0.85rem 1rem; border: 1px solid #1c1c2e;
}
.cs-name { font-size: var(--fs-label); font-weight: 600; color: #9090b0; margin-bottom: 0.5rem; text-transform: capitalize; }
.cs-temp { font-size: 1rem; font-weight: 700; margin-bottom: 0.2rem; }
.cs-pills { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 0.5rem; }
.cs-pill { font-size: var(--fs-micro); background: rgba(255,255,255,0.04); border-radius: 3px; padding: 2px 5px; color: #5a5a78; }

/* ── Flag rows ──────────────────────────────────────────────────── */
.flag-row { padding: 0.8rem 0; border-bottom: 1px solid #141420; }
.flag-row:last-child { border-bottom: none; }
.flag-hd { display: flex; align-items: center; gap: 0.7rem; }
.flag-pct { font-size: 1rem; font-weight: 700; min-width: 44px; text-align: right; flex-shrink: 0; }
.flag-pct.hi { color: #f87171; } .flag-pct.md { color: #fbbf24; } .flag-pct.lo { color: #7878a0; }
.flag-info { flex: 1; }
.flag-name { font-size: var(--fs-body); color: #c8c8de; font-weight: 500; }
.flag-meta { font-size: var(--fs-label); color: #8080aa; margin-top: 2px; }
.flag-bar { height: 3px; background: #1a1a28; border-radius: 2px; margin-top: 4px; }
.flag-bar-fill { height: 3px; border-radius: 2px; background: #7c6af7; }
.flag-desc { font-size: var(--fs-body); color: #8080aa; margin-top: 0.4rem; line-height: 1.55; padding-left: 56px; }

/* ── Aesthetic narrow range notice ─────────────────────────────── */
.range-note {
  background: #0f0e1a; border: 1px solid #1e1a3a; border-radius: 8px;
  padding: 0.9rem 1.1rem; font-size: 0.78rem; color: #8080aa; line-height: 1.6;
  margin-bottom: 1rem;
}

/* ── Pattern grid ───────────────────────────────────────────────── */
.pattern-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: 0.7rem; }
.pattern-card { background: #16161f; border-radius: 8px; padding: 0.85rem 1rem; border-left: 3px solid #1c1c2e; }
.pattern-card.dom { border-left-color: #7c6af7; }
.pattern-card.mod { border-left-color: #f97316; }
.ptn-name { font-size: var(--fs-body); font-weight: 600; color: #c8c8de; }
.ptn-conf-row { display: flex; align-items: center; gap: 0.5rem; margin: 0.35rem 0; }
.ptn-conf-bar { flex: 1; height: 4px; background: #1c1c2e; border-radius: 2px; }
.ptn-conf-fill { height: 4px; border-radius: 2px; }
.ptn-pct { font-size: var(--fs-sub); color: #7878a0; min-width: 38px; text-align: right; }
.ptn-desc { font-size: var(--fs-body); color: #8080aa; line-height: 1.55; margin-top: 0.3rem; }

/* ── Mobile overrides (≤ 600px) ─────────────────────────────────── */
@media (max-width: 600px) {
  body { font-size: 14px; }
  .page { padding: 0 0.85rem 4rem; }
  .card { padding: 1rem 1rem; }
  .hero { padding: 1.2rem 0 1rem; margin-bottom: 1rem; }
  .hero-digest { grid-template-columns: 1fr 1fr; }
  .hero-digest-item { border-right: none; border-bottom: 1px solid #17172a; }
  .hero-digest-item:nth-child(odd) { border-right: 1px solid #17172a; }
  .hero-digest-item:last-child, .hero-digest-item:nth-last-child(-n+2):nth-child(odd):last-child { border-bottom: none; }

  /* Strip: wrap so each item gets full width on very narrow screens */
  .strip { flex-wrap: wrap; border-radius: 8px; }
  .strip-item { flex: 1 1 45%; border-right: none; border-bottom: 1px solid #1c1c2e; }
  .strip-item:last-child { border-bottom: none; }

  /* Aesthetic score by scene — label was 140px, shrink it */
  .aes-scene-name { min-width: 80px; font-size: 0.72rem; }
  .aes-scene-count { min-width: 40px; }

  /* Flag rows — remove deep left indent on description */
  .flag-desc { padding-left: 0; }

  /* Tables — make them scrollable rather than overflowing */
  table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; width: max-content; max-width: 100%; }
  th, td { padding: 0.3rem 0.55rem; white-space: nowrap; }

  /* Scene tiles and color cards — allow smaller min-width */
  .scene-tiles { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
  .color-scene-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }

  /* Pattern grid already stacks via the .row media query, but ensure it here */
  .pattern-grid { grid-template-columns: 1fr; }
}

/* ── Back to top ────────────────────────────────────────────────── */
#back-to-top {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(124,106,247,0.12);
  border: 1px solid rgba(124,106,247,0.28);
  color: #7c6af7;
  font-size: 1.1rem;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s, background 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
#back-to-top.visible { opacity: 1; pointer-events: auto; }
#back-to-top:hover { background: rgba(124,106,247,0.28); }
</style>
</head>
<body>
<button id="hamburger" onclick="document.getElementById('sidebar').classList.toggle('open');document.getElementById('sidebar-overlay').classList.toggle('open');" aria-label="Open navigation">☰</button>
<div id="sidebar-overlay" onclick="document.getElementById('sidebar').classList.remove('open');document.getElementById('sidebar-overlay').classList.remove('open');"></div>

<nav id="sidebar">
  <div class="sb-logo">On-Device</div>
  <div class="sb-label">Photo Analytics</div>
  <a href="#s-overview">Overview</a>
  <div class="sb-label">Explore</div>
  <a href="#s-semantic">What You Shoot</a>
  <a href="#s-technical">How You Shoot</a>
  <a href="#s-gear">Gear &amp; Devices</a>
  <a href="#s-aesthetics">Editing &amp; Aesthetics</a>
  {% if _sources.has_lightroom %}<a href="#s-editing-journey">Editing Journey</a>{% endif %}
  <a href="#s-when">When You Shoot</a>
  {% if technical_settings_analysis and technical_settings_analysis.gps and technical_settings_analysis.gps.count > 0 %}<a href="#s-where">Where You Shoot</a>{% endif %}
  <a href="#s-context">Shooting Profile</a>
  <div class="sb-label">Signals</div>
  <a href="#s-forensics">Forensics</a>
</nav>

<div id="main-content">
<div class="page">

<!-- ══════════════════════════════════════ HERO ══════════════════ -->
<div class="hero" id="s-overview">
  <h1 class="hero-title" style="font-size:1.9rem;letter-spacing:0.04em;font-weight:800;text-transform:uppercase;color:#c8c8de;">On-Device Image Analytics</h1>
  <p class="hero-sub">{{ photo_count }} images · SigLIP2-base · aesthetic-predictor-v2-5 · CLIP-IQA+ · DINOv3-B · RMBG-2.0</p>
  <p style="font-size:0.82rem;color:#8080aa;line-height:1.7;margin-bottom:1rem;">This report analyzes your photo library using on-device AI models — covering shooting habits, composition patterns, editing style, color grading, and technical quality.</p>
  <div style="font-size:0.68rem;font-weight:700;color:#7878a0;text-transform:uppercase;letter-spacing:0.12em;margin-bottom:0.6rem;">Highlights</div>
  <div class="stat-grid">
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-semantic').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Dominant Scene</div>
      {% set dom_scenes = agg.scene_stats.dominant_scenes or [] %}
      {% set dom_pct = (scene_dist.get(dom_scenes[0], 0) / photo_count * 100)|round|int if dom_scenes and photo_count > 0 else 0 %}
      <div class="stat-v" style="font-size:1.1rem;text-transform:capitalize;">{{ dom_scenes | join(" · ") if dom_scenes else "—" }}</div>
      <div class="stat-s">{{ dom_pct }}% of library</div>
    </div>
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-aesthetics').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Avg Aesthetic Score</div>
      <div class="stat-v">{{ "%.1f"|format(aesthetic_stats.avg_score or 0) }}<span style="font-size:0.78rem;font-weight:400;color:#7878a0;"> / 100</span></div>
      <div class="stat-s">range {{ "%.0f"|format(aesthetic_stats.min_score or 0) }}–{{ "%.0f"|format(aesthetic_stats.max_score or 0) }}</div>
    </div>
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-semantic').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Visual Clusters</div>
      <div class="stat-v">{{ clusters.n_clusters or "—" }}</div>
      <div class="stat-s">DINOv3-B + KMeans</div>
    </div>
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-technical').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Avg Resolution</div>
      <div class="stat-v">{{ "%.1f"|format(megapixel_stats.avg or 0) }}<span style="font-size:0.78rem;font-weight:400;color:#7878a0;">MP</span></div>
      <div class="stat-s">{{ megapixel_stats.min }}–{{ megapixel_stats.max }}MP range</div>
    </div>
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-technical').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Exposure Bias</div>
      <div class="stat-v">{{ "%+.2f"|format(exposure_stats.avg_bias or 0) }}</div>
      <div class="stat-s">0 = neutral</div>
    </div>
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-aesthetics').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Editing Style</div>
      <div class="stat-v" style="font-size:1.0rem;">{% if editing_style_patterns %}{{ editing_style_patterns[0].name }}{% else %}—{% endif %}</div>
      <div class="stat-s">{% if editing_style_patterns %}{{ "%.0f"|format(editing_style_patterns[0].confidence * 100) }}% confidence{% endif %}</div>
    </div>
    {% if storage_tiers and storage_tiers.redundant_count %}
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-semantic').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Redundant Images</div>
      <div class="stat-v">{{ storage_tiers.redundant_count }}</div>
      <div class="stat-s">similar image duplicates</div>
    </div>
    {% endif %}
    {% if ela_stats and ela_stats.extreme_outlier_count is defined and ela_stats.extreme_outlier_count > 0 %}
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-forensics').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">ELA Outliers</div>
      <div class="stat-v">{{ ela_stats.extreme_outlier_count }}</div>
      <div class="stat-s">unusual compression artifacts</div>
    </div>
    {% endif %}
    {% if iso_median is not none %}
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-gear').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">ISO Preference</div>
      <div class="stat-v">{{ iso_median }}</div>
      <div class="stat-s">{{ iso_label }}</div>
    </div>
    {% endif %}
    {% if prime_pct is not none %}
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-gear').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Prime vs Zoom</div>
      <div class="stat-v">{{ prime_pct }}%<span style="font-size:0.78rem;font-weight:400;color:#7878a0;"> prime</span></div>
      <div class="stat-s">{{ 100 - prime_pct }}% zoom lenses</div>
    </div>
    {% endif %}
    {% if dominant_shutter %}
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-gear').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Capture Style</div>
      <div class="stat-v" style="font-size:1rem;">{{ dominant_shutter }}</div>
      <div class="stat-s">{% if dominant_shutter_pct %}{{ dominant_shutter_pct }}% of shots{% endif %}</div>
    </div>
    {% endif %}
    {% if iq_stats and not iq_stats.unavailable and iq_stats.avg is not none %}
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-technical').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">Avg IQ Score</div>
      <div class="stat-v">{{ "%.0f"|format(iq_stats.avg) }}<span class="stat-u">/100</span></div>
      <div class="stat-s">sharpness · exposure · noise</div>
    </div>
    {% endif %}
    {% if high_aes_low_iq %}
    <div class="stat" style="cursor:pointer;" onclick="document.getElementById('s-aesthetics').scrollIntoView({behavior:'smooth'})">
      <div class="stat-l">High Feel, Low IQ</div>
      <div class="stat-v" style="color:#f87171;">{{ high_aes_low_iq }} photos</div>
      <div class="stat-s">aesthetic &gt;65 · technical IQ &lt;40</div>
    </div>
    {% endif %}
  </div>
</div>

<!-- ══════════════════════════════════════ QUALITY ISSUES ════════════════ -->
{% if coach and coach.flags %}
{% set _top_flags = coach.flags.items() | sort(attribute='1.pct', reverse=true) | selectattr('1.pct', 'ge', 5) | list %}
{% if _top_flags %}
<div class="card mb" style="border-left:3px solid #f87171;">
  <div class="card-title" style="margin-bottom:0.6rem;">Issues Summary</div>
  {% for key, info in _top_flags[:4] %}
  <div style="display:flex;gap:0.6rem;align-items:flex-start;padding:0.45rem 0;border-bottom:1px solid #14141f;">
    <span style="flex-shrink:0;margin-top:5px;display:inline-block;width:5px;height:5px;border-radius:50%;background:#f87171;"></span>
    <div style="font-size:0.78rem;color:#9090b8;line-height:1.6;">{{ info.description }}</div>
  </div>
  {% endfor %}
  {% if high_aes_low_iq %}
  <div style="display:flex;gap:0.6rem;align-items:flex-start;padding:0.45rem 0;">
    <span style="flex-shrink:0;margin-top:5px;display:inline-block;width:5px;height:5px;border-radius:50%;background:#f87171;"></span>
    <div style="font-size:0.78rem;color:#9090b8;line-height:1.6;">{{ high_aes_low_iq }} photos score high aesthetically (&gt;65) but low on technical quality (&lt;40) — likely due to motion blur, noise, or soft focus. These are candidates for a reshoot or a sharper edit pass.</div>
  </div>
  {% endif %}
</div>
{% endif %}
{% endif %}

<!-- ══════════════════════════════════════ WHAT YOU SHOOT ══════════════════ -->
<details open id="s-semantic" style="margin-bottom:0;">
<summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 0 0.5rem;font-size:0.68rem;font-weight:700;color:#7878a0;text-transform:uppercase;letter-spacing:0.12em;border-bottom:1px solid #1a1a2e;margin-bottom:1rem;" class="section-summary">What You Shoot</summary>

<!-- Scene Preferences (doughnut + sorted bar) + Visual Attributes -->
<div class="row c4-8 mb">
  <div class="card">
    <div class="card-title">Scene Preferences <span style="color:#8080aa;font-size:0.6rem;font-weight:400;">% of library · multi-label</span></div>
    {% set sc_colors = ["#7c6af7","#10b981","#f59e0b","#3b82f6","#ec4899","#f97316","#06b6d4","#8b5cf6","#22c55e","#ef4444"] %}
    {% for label, count in scene_dist.items()|sort(attribute=1,reverse=True) %}{% if count > 0 %}
    {% set pct = [(count / photo_count * 100)|round(1), 100]|min %}
    {% set col = sc_colors[loop.index0 % sc_colors|length] %}
    <div style="margin-bottom:7px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:2px;">
        <span style="font-size:0.78rem;color:#c0c0d8;text-transform:capitalize;">{{ label }}</span>
        <span style="font-size:0.72rem;color:#7878a0;">{{ pct }}% · {{ count }}</span>
      </div>
      <div style="background:#16161f;border-radius:3px;height:5px;">
        <div style="width:{{ pct }}%;background:{{ col }};border-radius:3px;height:5px;opacity:0.8;"></div>
      </div>
    </div>
    {% endif %}{% endfor %}
  </div>
  {% set va = visual_attributes %}
  {% if va and va.total_analyzed %}
  <div class="card">
    <div class="card-title">Visual Attributes &amp; Aesthetic <span style="color:#8080aa;font-size:0.6rem;font-weight:400;">SigLIP2-base VQA · % share · avg aesthetic score</span></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;">
      {% set attr_meta = [("season","Season","#ec4899"),("has_person","People Present","#7c6af7"),("setting","Setting","#10b981"),("time_of_day","Time of Day","#f59e0b"),("weather","Weather","#3b82f6")] %}
      {% for key, label, color in attr_meta %}
      {% set items = va.get(key, []) %}
      {% set aes_map = aesthetic_by_vqa.get(key, {}) %}
      {% if items %}
      <div>
        <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">{{ label }}</div>
        {% for item in items %}
        {% set aes_score = aes_map.get(item.label) %}
        <div style="margin-bottom:6px;">
          <div style="display:flex;justify-content:space-between;margin-bottom:2px;">
            <span style="font-size:0.78rem;color:#c0c0d8;text-transform:capitalize;">{{ item.label }}</span>
            <span style="font-size:0.72rem;color:#7878a0;">{{ item.pct }}%{% if aes_score is not none %} · <span style="color:{{ color }};">{{ aes_score }}</span>{% endif %}</span>
          </div>
          <div style="background:#16161f;border-radius:3px;height:5px;">
            <div style="width:{{ item.pct }}%;background:{{ color }};border-radius:3px;height:5px;opacity:0.75;"></div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
  {% endif %}
</div>

<!-- UMAP — compact -->
<div class="card mb" style="padding: 1.2rem 1.6rem;">
  <div class="card-title" style="margin-bottom:0.4rem;">Visual Similarity Map <span style="color:#8080aa;font-weight:400;font-size:0.6rem;">{{ umap_points|length }} of {{ umap_total }} images · hover for details</span></div>
  <div class="card-desc" style="margin-bottom:0.8rem;">Each dot is one photo. Nearby dots look visually similar. <strong style="color:#9090b8;">Clusters</strong> reveal shooting tendencies — tight groups mean a consistent style, isolated dots are unique shots. Colored by visual similarity cluster (DINOv3 groups); hover for details.</div>
  <div class="chart-h" style="height:280px;"><canvas id="umapChart" style="max-height:280px;"></canvas></div>
</div>

</details>

<!-- ══════════════════════════════════════ HOW YOU SHOOT ══════════════════ -->
<details open id="s-technical" style="margin-bottom:0;">
<summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 0 0.5rem;font-size:0.68rem;font-weight:700;color:#7878a0;text-transform:uppercase;letter-spacing:0.12em;border-bottom:1px solid #1a1a2e;margin-bottom:1rem;" class="section-summary">How You Shoot</summary>

<!-- Focal / Aperture / ISO -->
{% if focal_length_bars or aperture_bars or iso_bars %}
<div class="row {% if focal_length_bars and aperture_bars and iso_bars %}three{% elif focal_length_bars and aperture_bars %}two{% else %}two{% endif %} mb">
  {% macro gear_bars(items, color) %}
    {% set max_pct = items|map(attribute='pct')|max %}
    <div class="collapsible-gear" style="max-height:200px;overflow:hidden;">
    {% for item in items %}
    <div style="margin-bottom:6px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:2px;">
        <span style="font-size:0.78rem;color:#c0c0d8;">{{ item.label }}</span>
        <span style="font-size:0.72rem;color:#7878a0;">{{ item.pct }}% · {{ item.count }}</span>
      </div>
      <div style="background:#16161f;border-radius:3px;height:5px;">
        <div style="width:{{ [(item.pct / max_pct * 100)|round|int, 100]|min }}%;background:{{ color }};border-radius:3px;height:5px;opacity:0.75;"></div>
      </div>
    </div>
    {% endfor %}
    </div>
    <button class="expand-btn" onclick="_gearToggle(this)" style="margin-top:4px;background:none;border:none;color:#5a5a78;font-size:0.68rem;cursor:pointer;padding:0;">Show all ↓</button>
  {% endmacro %}
  {% if focal_length_bars %}
  <div class="card">
    <div class="card-title">Focal Length</div>
    {{ gear_bars(focal_length_bars, "#f97316") }}
  </div>
  {% endif %}
  {% if aperture_bars %}
  <div class="card">
    <div class="card-title">Aperture</div>
    {{ gear_bars(aperture_bars, "#10b981") }}
  </div>
  {% endif %}
  {% if iso_bars %}
  <div class="card">
    <div class="card-title">ISO Sensitivity</div>
    {{ gear_bars(iso_bars, "#f59e0b") }}
  </div>
  {% endif %}
</div>
{% endif %}

<!-- Composition Analysis -->
<div class="row c7-5 mb">

  <!-- LEFT: Composition Style — pattern list + metrics strip -->
  <div class="card">
    <div class="card-title">Composition Style</div>
    {% if composition_patterns %}
    {% set cp_descs = {
      "Rule of Thirds": "Subject or key element placed near a thirds intersection, adding visual tension and naturally directing the viewer's eye across the frame.",
      "Subject Isolation": "Centre zone is significantly sharper than the surroundings — the subject pops cleanly from its background via shallow depth of field or high contrast.",
      "Strong Symmetry": "High left/right mirroring across the frame, common in architectural subjects, reflections, or deliberately geometric compositions.",
      "Negative Space": "Unusually large empty areas surround the subject, giving it room to breathe and drawing the viewer's attention through contrast with the void.",
      "Foreground Interest": "Complex edge density in the bottom zone indicates foreground elements that add depth, texture, or layering to the scene.",
    } %}
    {% set cp_metrics = {
      "Rule of Thirds": "Score: " ~ "%.2f"|format(composition_stats.avg_thirds_score or 0) ~ " — 0=centred, 1=off-centre",
      "Strong Symmetry": "Score: " ~ "%.2f"|format(composition_stats.avg_symmetry_score or 0) ~ " — left/right mirror ratio",
      "Negative Space": "Score: " ~ "%.2f"|format(composition_stats.avg_negative_space or 0) ~ " — empty-frame fraction",
      "Subject Isolation": "Score: " ~ "%.2f"|format(composition_stats.avg_subject_isolation or 0) ~ " — ratio vs surroundings",
      "Foreground Interest": "Score: " ~ "%.2f"|format(composition_stats.avg_foreground_clutter or 0) ~ " — lower = cleaner frame",
    } %}
    <div class="cp-list">
      {% for p in composition_patterns %}
      <div class="cp-row">
        <div class="cp-pct">{{ p.pct }}%</div>
        <div class="cp-body" style="flex:1;">
          <div class="cp-name">{{ p.name }}</div>
          {% if cp_metrics.get(p.name) %}<div style="font-size:0.78rem;color:#9090b8;margin-top:3px;margin-bottom:2px;">{{ cp_metrics[p.name] }}</div>{% endif %}
          <div class="cp-desc">{{ cp_descs.get(p.name, p.description) }}</div>
          <div class="cp-bar"><div class="cp-bar-fill" style="width:{{ [p.pct,100]|min }}%;"></div></div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <!-- RIGHT: Composition Grid -->
  <div class="card">
    <div class="card-title">Composition Grid</div>
    {% if grid_heatmap %}
    {% set flat = [] %}{% for row in grid_heatmap %}{% for v in row %}{% set _ = flat.append(v) %}{% endfor %}{% endfor %}
    {% set mxv = flat | max %}
    {% set center_val = grid_heatmap[1][1] %}
    {% set corner_avg = (grid_heatmap[0][0] + grid_heatmap[0][2] + grid_heatmap[2][0] + grid_heatmap[2][2]) / 4 %}
    {% set edge_avg = (grid_heatmap[0][1] + grid_heatmap[1][0] + grid_heatmap[1][2] + grid_heatmap[2][1]) / 4 %}

    <!-- Edge activity + Subject placement: equal 1fr 1fr columns so grids are same size -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;align-items:start;">
      <div>
        <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">Detail Density by Zone</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px;">
          {% for row in grid_heatmap %}{% for v in row %}
          <div style="aspect-ratio:1;background:rgba(124,106,247,{{ (v/(mxv+0.001))|round(2) }});border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:0.65rem;color:#e0d8ff;font-weight:500;">{{ "%.2f"|format(v) }}</div>
          {% endfor %}{% endfor %}
        </div>
        <div style="margin-top:0.5rem;font-size:0.75rem;color:#7878a8;line-height:1.5;">Brighter = more edges and detail in that zone. Centre <strong style="color:#c0c0d8;">{{ "%.2f"|format(center_val) }}</strong> vs corners avg <strong style="color:#c0c0d8;">{{ "%.2f"|format(corner_avg) }}</strong>.</div>
      </div>

      {% if saliency_stats and saliency_stats.total_analyzed > 0 %}
      {% set sp = saliency_stats.placement_distribution %}
      {% set sp_flat = [] %}{% for row in sp %}{% for v in row %}{% set _ = sp_flat.append(v) %}{% endfor %}{% endfor %}
      {% set sp_max = sp_flat | max %}
      <div>
        <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">Subject Placement</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px;">
          {% for row in sp %}{% for v in row %}
          <div style="aspect-ratio:1;background:rgba(16,185,129,{{ (v/(sp_max+0.001))|round(2) }});border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:{% if v > sp_max*0.35 %}#d0f5e8{% else %}#2a4a3a{% endif %};">{{ (v*100)|round|int }}%</div>
          {% endfor %}{% endfor %}
        </div>
        <div style="margin-top:0.5rem;font-size:0.75rem;color:#7878a8;line-height:1.5;">Darker green = more images placed in that zone. Subject fills avg <strong style="color:#c0c0d8;">{{ "%.0f"|format((saliency_stats.avg_subject_area or 0)*100) }}%</strong> of the frame; <strong style="color:#c0c0d8;">{{ "%.3f"|format(saliency_stats.avg_off_center or 0) }}</strong> off-centre (0 = perfectly centred).</div>
      </div>
      {% endif %}
    </div>

    <!-- Horizon position -->
    {% set hd = composition_stats.horizon_position_distribution %}
    {% set ht = (hd.high or 0) + (hd.mid or 0) + (hd.low or 0) + (hd.none or 0) %}
    {% if ht > 0 %}
    <div style="margin-bottom:1.1rem;">
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.5rem;">Horizon Position <span title="Estimated position of the primary horizontal line (horizon, skyline, or table edge) in the frame. Top = sky-dominant; Bottom = ground-dominant; None = no strong horizontal detected." style="cursor:help;color:#4a4a6a;font-size:0.6rem;border-bottom:1px dashed #4a4a6a;">?</span></div>
      {% for pos, lbl in [("high","Top"),("mid","Mid"),("low","Bottom"),("none","None")] %}
      {% set pct = ((hd[pos] or 0) / ht * 100)|round|int %}
      <div class="dbar">
        <div class="dbar-row"><span>{{ lbl }}</span><span>{{ pct }}%</span></div>
        <div class="dbar-bg"><div class="dbar-fill" style="width:{{ pct }}%;background:#7c6af7;"></div></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <!-- Zone interpretation -->
    <div style="border-top:1px solid #1a1a28;padding-top:0.75rem;">
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.3rem;">Zone Interpretation</div>
      <div style="font-size:0.75rem;color:#7878a8;line-height:1.5;">
        {% if center_val > corner_avg * 1.5 %}
          <strong style="color:#ddd8f0;">Center-dominant</strong> — most visual detail and subject matter sits in the middle of the frame. The centre zone scores <strong style="color:#c0c0d8;">{{ "%.2f"|format(center_val) }}</strong> versus a corner average of <strong style="color:#c0c0d8;">{{ "%.2f"|format(corner_avg) }}</strong>, a ratio typical of telephoto or portrait-heavy libraries.
        {% elif edge_avg > center_val %}
          <strong style="color:#ddd8f0;">Edge-driven</strong> — borders and edges carry more detail than the centre, suggesting wide-angle framing, environmental context, or deliberate use of foreground and leading lines. Edge avg <strong style="color:#c0c0d8;">{{ "%.2f"|format(edge_avg) }}</strong> vs centre <strong style="color:#c0c0d8;">{{ "%.2f"|format(center_val) }}</strong>.
        {% else %}
          <strong style="color:#ddd8f0;">Balanced</strong> — edge activity is spread evenly across all zones with no single area dominating, indicating a varied mix of subject types and framing approaches.
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>

</div>

<!-- Sharpness & Exposure -->
<div class="row mb">
  <div class="card">
    <div class="card-title">Sharpness & Exposure</div>
    <div class="strip mb">
      <div class="strip-item">
        {% set sh_avg = sharpness_stats.avg or 0 %}
        <div class="strip-v">{% if sh_avg > 800 %}Very Sharp{% elif sh_avg > 400 %}Sharp{% elif sh_avg > 150 %}Soft{% else %}Blurry{% endif %}</div>
        <div class="strip-l">Avg Sharpness</div>
        <div class="strip-s">score {{ "%.0f"|format(sh_avg) }} · &gt;800 = crisp, &lt;150 = blurry</div>
      </div>
      <div class="strip-item">
        <div class="strip-v">{{ "%+.2f"|format(exposure_stats.avg_bias or 0) }}</div>
        <div class="strip-l">Exposure Bias</div>
        <div class="strip-s">0 = neutral · + = brighter · − = darker</div>
      </div>
      <div class="strip-item">
        <div class="strip-v">{{ "%.1f"|format(exposure_stats.highlight_clipped_pct or 0) }}%</div>
        <div class="strip-l">Highlights Clipped</div>
        <div class="strip-s">images with blown highlights</div>
      </div>
    </div>
  </div>
</div>

<!-- Portrait Insights -->
{% if pose_stats and pose_stats.portrait_count >= 20 %}
{% set ft = pose_stats.framing_tiers %}
{% set fa = pose_stats.framing_aesthetic %}
{% set sg = pose_stats.solo_vs_group %}
{% set pcd = pose_stats.person_count_dist %}
<div class="row two mb">
  <div class="card">
    <div class="card-title">Portrait Insights <span style="color:#8080aa;font-weight:400;">{{ pose_stats.portrait_count }} images · YOLO11n-pose</span></div>
    <div class="stat-grid" style="margin-bottom:0;gap:0.3rem;">
      {% if sg %}
      <div class="stat" style="padding:0.5rem 0.6rem;"><div class="stat-l">Solo</div><div class="stat-v">{{ sg.solo }}</div><div class="stat-s">1 person</div></div>
      {% endif %}
      {% if pcd %}
      <div class="stat" style="padding:0.5rem 0.6rem;"><div class="stat-l">Pair</div><div class="stat-v">{{ pcd.get("2", 0) }}</div><div class="stat-s">2 people</div></div>
      <div class="stat" style="padding:0.5rem 0.6rem;"><div class="stat-l">Group 3+</div><div class="stat-v">{{ (pcd.get("3", 0) or 0) + (pcd.get("4+", 0) or 0) }}</div><div class="stat-s">3 or more</div></div>
      {% endif %}
    </div>
  </div>
  {% if ft %}
  {% set ft_total = ft.values() | sum or 1 %}
  {% set ft_sorted = [("tight", ft.get("tight",0)), ("medium", ft.get("medium",0)), ("wide", ft.get("wide",0))] | sort(attribute='1', reverse=True) %}
  {% set ft_colors = ["#7c6af7","#10b981","#3b82f6"] %}
  <div class="card">
    <div class="card-title">Framing Style</div>
    <div style="display:flex;gap:0.5rem;">
      {% for ft_name, ft_cnt in ft_sorted %}
      {% set ft_pct = (ft_cnt / ft_total * 100)|round|int %}
      {% set ft_col = ft_colors[loop.index0] %}
      <div style="flex:1;background:{{ ft_col }};opacity:{{ 1.0 - loop.index0 * 0.25 }};border-radius:8px;padding:0.7rem 0.4rem;text-align:center;">
        <div style="font-size:1.1rem;font-weight:700;color:#fff;opacity:1;">{{ ft_pct }}%</div>
        <div style="font-size:0.68rem;color:#ffffffcc;text-transform:capitalize;margin-top:2px;">{{ ft_name }}</div>
        {% if fa and fa.get(ft_name) %}<div style="font-size:0.6rem;color:#ffffff99;margin-top:1px;">{{ fa[ft_name]|round(1) }} aesthetic</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>
{% endif %}

</details>

<!-- ═══════════════════════════════════════ GEAR & DEVICES ════════════════ -->
<details open id="s-gear" style="margin-bottom:0;">
<summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 0 0.5rem;font-size:0.68rem;font-weight:700;color:#7878a0;text-transform:uppercase;letter-spacing:0.12em;border-bottom:1px solid #1a1a2e;margin-bottom:1rem;" class="section-summary">Gear &amp; Devices</summary>

{% set tsa = technical_settings_analysis %}
{% if tsa %}
<div class="card mb">
  <div class="card-title">Camera Bodies &amp; Lenses</div>
  {% if tsa.device_breakdown %}
  <div class="card-desc" style="margin-bottom:0.6rem;">Camera body types across the library.</div>
  <div class="strip mb" style="margin-bottom:1rem;">
    {% set dev_total = tsa.device_breakdown.values() | sum(attribute='count') or 1 %}
    {% for cat, d in tsa.device_breakdown.items() | sort(attribute='1.count', reverse=true) %}
    <div class="strip-item" style="flex:{{ d.count / dev_total }};min-width:80px;">
      <div class="strip-v">{{ d.count }}</div>
      <div class="strip-s">{{ cat }}</div>
      {% if d.avg_aesthetic is not none %}<div class="strip-s" style="color:#7c6af7;">{{ "%.1f"|format(d.avg_aesthetic) }} aes</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <div class="row two" style="margin-top:1rem;gap:1rem;align-items:start;">
    {% if tsa.top_lenses %}
    <div>
      <div style="margin-bottom:0.5rem;font-size:0.75rem;color:#9090b8;text-transform:uppercase;letter-spacing:0.05em;">Top Lenses</div>
      {% set lens_max = tsa.top_lenses.values() | max %}
      {% set sorted_lenses = tsa.top_lenses.items() | list | sort(attribute=1, reverse=true) %}
      <div id="lens-collapsible" class="collapsible-gear" style="max-height:130px;overflow:hidden;">
      {% for lens, cnt in sorted_lenses %}
      {% set lens_pct = (cnt / photo_count * 100)|round(1) %}
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;">
        <div style="font-size:0.75rem;min-width:130px;color:#c8c8e8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="{{ lens }}">{{ lens }}</div>
        <div style="flex:1;background:#1c1c2e;border-radius:3px;height:6px;"><div style="width:{{ (cnt/lens_max*100)|round(1) }}%;background:#7c6af7;height:100%;border-radius:3px;"></div></div>
        <div style="font-size:0.72rem;color:#9090b8;min-width:60px;text-align:right;">{{ lens_pct }}% · {{ cnt }}</div>
      </div>
      {% endfor %}
      </div>
      <button class="expand-btn" onclick="_gearToggle(this)" style="margin-top:4px;background:none;border:none;color:#5a5a78;font-size:0.68rem;cursor:pointer;padding:0;">Show all ↓</button>
    </div>
    {% endif %}
    {% if tsa.shutter_category_distribution %}
    {% set shutter_labels = {"freeze": "Fast Shutter (≤1/500s)", "hand": "Handheld (1/500–1/60s)", "slow": "Slow (1/60–1/15s)", "bulb": "Bulb (>1/15s)"} %}
    <div id="motion-style-col">
      <div style="font-size:0.72rem;color:#9090b8;margin-bottom:0.5rem;text-transform:uppercase;letter-spacing:0.05em;">Motion Style</div>
      {% set sh_total = tsa.shutter_category_distribution.values() | sum or 1 %}
      {% for cat, cnt in tsa.shutter_category_distribution.items() | sort(attribute='1', reverse=true) %}
      {% set sh_pct = (cnt/sh_total*100)|round(1) %}
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:5px;">
        <div style="font-size:0.75rem;color:#c0c0d8;min-width:160px;">{{ shutter_labels.get(cat, cat) }}</div>
        <div style="flex:1;background:#16161f;border-radius:3px;height:6px;"><div style="width:{{ sh_pct|round|int }}%;background:#60a5fa;height:100%;border-radius:3px;"></div></div>
        <div style="font-size:0.72rem;color:#9090b8;min-width:36px;text-align:right;">{{ sh_pct }}%</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% if tsa.gps and tsa.gps.count > 0 %}
  <div style="margin-top:1rem;padding:0.6rem 0.8rem;background:#13131f;border-radius:6px;">
    <div style="font-size:0.72rem;color:#9090b8;text-transform:uppercase;letter-spacing:0.05em;">GPS Coverage</div>
    <div style="font-size:1.2rem;font-weight:700;color:#7c6af7;">{{ tsa.gps.pct }}%</div>
    <div style="font-size:0.72rem;color:#9090b8;">{{ tsa.gps.count }} images with location data · bounds {{ "%.2f"|format(tsa.gps.bounds.lat_min) }}–{{ "%.2f"|format(tsa.gps.bounds.lat_max) }}°N, {{ "%.2f"|format(tsa.gps.bounds.lon_min) }}–{{ "%.2f"|format(tsa.gps.bounds.lon_max) }}°E</div>
  </div>
  {% endif %}
</div>
{% endif %}


</details>

<!-- ══════════════════════════════════════ EDITING STYLE ══════════════════ -->
<details open id="s-aesthetics" style="margin-bottom:0;">
<summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 0 0.5rem;font-size:0.68rem;font-weight:700;color:#7878a0;text-transform:uppercase;letter-spacing:0.12em;border-bottom:1px solid #1a1a2e;margin-bottom:1rem;" class="section-summary">Editing &amp; Aesthetics</summary>

{% macro render_style_patterns(patterns, label) %}
{% if patterns %}
<div>
  {% if label %}<div style="font-size:0.62rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.6rem;border-bottom:1px solid #1a1a28;padding-bottom:0.4rem;">{{ label }}</div>{% endif %}
  {% if patterns | length == 1 %}
  {% set p = patterns[0] %}
  <div style="font-size:1.6rem;font-weight:700;color:#7c6af7;line-height:1.2;margin-bottom:0.3rem;">{{ p.name }}</div>
  <div style="font-size:0.75rem;color:#8080aa;margin-bottom:0.6rem;">{{ "%.0f"|format(p.confidence * 100) }}% confidence</div>
  {% if p.description %}<div style="font-size:0.8rem;color:#9090b8;line-height:1.55;max-width:72ch;">{{ p.description }}</div>{% endif %}
  {% else %}
  {% for p in patterns %}
  {% set tier = "dom" if p.confidence >= 0.65 else "mod" if p.confidence >= 0.35 else "" %}
  <div class="pattern-card {{ tier }}" style="margin-bottom:0.4rem;">
    <div class="ptn-name">{{ p.name }}</div>
    <div class="ptn-conf-row">
      <div class="ptn-conf-bar"><div class="ptn-conf-fill" style="width:{{ (p.confidence*100)|int }}%;background:{% if p.confidence>=0.65 %}#7c6af7{% elif p.confidence>=0.35 %}#f97316{% else %}#4b5563{% endif %};"></div></div>
      <div class="ptn-pct">{{ "%.0f"|format(p.confidence*100) }}%</div>
    </div>
  </div>
  {% endfor %}
  {% endif %}
</div>
{% else %}
<div>
  {% if label %}<div style="font-size:0.62rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.6rem;border-bottom:1px solid #1a1a28;padding-bottom:0.4rem;">{{ label }}</div>{% endif %}
  <div style="font-size:0.78rem;color:#505068;">No data</div>
</div>
{% endif %}
{% endmacro %}

<!-- Editing Style Analysis + Aesthetic Quality — side by side -->
<div class="row two mb">
  {% if editing_style_patterns %}
  <div class="card">
    <div class="card-title">Editing Style Analysis</div>
    {{ render_style_patterns(editing_style_patterns, "") }}
  </div>
  {% endif %}
  <div class="card">
    <div class="card-title">Aesthetic Quality <span style="font-weight:400;color:#7878a0;">aesthetic-predictor-v2-5</span></div>
    <div class="stat-grid" style="margin-bottom:1rem;">
      <div class="stat"><div class="stat-l">Average</div><div class="stat-v">{{ "%.1f"|format(aesthetic_stats.avg_score or 0) }}</div><div class="stat-s">{{ "%.0f"|format(aesthetic_stats.min_score or 0) }}–{{ "%.0f"|format(aesthetic_stats.max_score or 0) }} range · out of 100</div></div>
      <div class="stat"><div class="stat-l">Median</div><div class="stat-v">{{ "%.1f"|format(aesthetic_stats.median_score or 0) }}</div></div>
      <div class="stat"><div class="stat-l">Std Dev</div><div class="stat-v">{{ "%.2f"|format(aesthetic_stats.score_std or 0) }}</div><div class="stat-s">lower = more uniform</div></div>
    </div>
    <div class="range-note">
      {% if aesthetic_stats.score_std and aesthetic_stats.score_std < 2 %}
      Scores cluster tightly (σ={{ "%.2f"|format(aesthetic_stats.score_std) }}) across the {{ "%.0f"|format(aesthetic_stats.min_score or 0) }}–{{ "%.0f"|format(aesthetic_stats.max_score or 0) }} range — the model sees your editing as highly consistent. Scores of 50–65 indicate competently edited photography.
      {% else %}
      Scores of 50–65 indicate well-edited photography. Your avg of {{ "%.1f"|format(aesthetic_stats.avg_score or 0) }} places your library solidly in that bracket.
      {% endif %}
    </div>
  </div>
</div>

<!-- Color Grading + Color & Mood -->
<div class="row c5-7 mb">
  <div class="card">
    <div class="card-title">Color Grading</div>
    {% set cgs = color_grading_stats %}
    <div class="stat-grid" style="margin-bottom:1rem;grid-template-columns:1fr 1fr;">
      <div class="stat">
        <div class="stat-l">Tonal Style</div>
        <div class="stat-v" style="font-size:0.9rem;text-transform:capitalize;">{{ cgs.tonal_style or "—" }}</div>
        <div class="stat-s">{{ cgs.tonal_description or "" }}</div>
      </div>
      <div class="stat">
        <div class="stat-l">Color Temp.</div>
        <div class="stat-v" style="font-size:0.9rem;text-transform:capitalize;">{{ cgs.color_temperature or "—" }}</div>
        <div class="stat-s">{{ cgs.color_temperature_description or "" }}</div>
      </div>
    </div>
    {% set hps = cgs.harmony_pcts %}
    {% if hps %}
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin:0.9rem 0 0.5rem;">Color Harmony</div>
    {% set hcols = {"analogous":"#7c6af7","complementary":"#f97316","triadic":"#10b981","monochromatic":"#94a3b8","mixed":"#f59e0b"} %}
    {% for htype, pct in hps.items() %}
    <div class="dbar">
      <div class="dbar-row"><span style="text-transform:capitalize;">{{ htype }}</span><span>{{ pct }}%</span></div>
      <div class="dbar-bg"><div class="dbar-fill" style="width:{{ pct }}%;background:{{ hcols.get(htype,'#4b5563') }};"></div></div>
    </div>
    {% endfor %}
    {% endif %}
    {% if split_toning and split_toning.toning_style %}
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin:0.9rem 0 0.5rem;">Split Toning Fingerprint</div>
    <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem;">
      {% for label, key in [("Shadows", "shadow_color"), ("Midtones", "midtone_color"), ("Highlights", "highlight_color")] %}
      <div style="display:flex;flex-direction:column;align-items:center;gap:0.25rem;flex:1;">
        <div style="width:100%;height:28px;border-radius:5px;background:{{ split_toning[key] }};border:1px solid #2a2a3e;"></div>
        <div style="font-size:0.58rem;color:#7878a0;">{{ label }}</div>
        <div style="font-size:0.6rem;color:#9090b8;font-family:monospace;">{{ split_toning[key] }}</div>
      </div>
      {% endfor %}
    </div>
    <div style="font-size:0.72rem;color:#c8c8e8;">{{ split_toning.toning_style }}</div>
    {% if split_toning.avg_balance is not none %}
    <div style="font-size:0.65rem;color:#7878a0;margin-top:0.3rem;">Balance {{ "%+.1f"|format(split_toning.avg_balance) }} · shadow lift {{ "%.1f"|format(split_toning.shadow_lum_shift) }} EV · highlight push {{ "%.1f"|format(split_toning.highlight_lum_shift) }} EV</div>
    {% endif %}
    {% endif %}
  </div>

  <div class="card">
    <div class="card-title">Color &amp; Mood</div>
    {% if fg_palette_colors or bg_palette_colors %}
    <div style="margin-bottom:0.75rem;">
      {% if fg_palette_colors %}
      <div style="font-size:0.62rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.3rem;">Subject</div>
      <div class="swatches" style="margin-bottom:0.5rem;">{% for rgb in fg_palette_colors %}<div class="swatch" style="background:rgb({{ rgb[0] }},{{ rgb[1] }},{{ rgb[2] }});"></div>{% endfor %}</div>
      {% endif %}
      {% if bg_palette_colors %}
      <div style="font-size:0.62rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.3rem;">Background</div>
      <div class="swatches">{% for rgb in bg_palette_colors %}<div class="swatch" style="background:rgb({{ rgb[0] }},{{ rgb[1] }},{{ rgb[2] }});"></div>{% endfor %}</div>
      {% endif %}
    </div>
    {% else %}
    {% set palette_colors = [] %}
    {% for photo in photos %}{% if photo.color and photo.color.palette %}{% for sw in photo.color.palette %}{% if palette_colors|length < 40 %}{% set _ = palette_colors.append(sw.rgb) %}{% endif %}{% endfor %}{% endif %}{% endfor %}
    <div class="swatches">{% for rgb in palette_colors %}<div class="swatch" style="background:rgb({{ rgb[0] }},{{ rgb[1] }},{{ rgb[2] }});"></div>{% endfor %}</div>
    {% endif %}
    <div class="stat-grid" style="margin-bottom:1rem;grid-template-columns:1fr 1fr;">
      <div class="stat"><div class="stat-l">Saturation</div><div class="stat-v">{{ "%.2f"|format(color_stats.avg_saturation or 0) }}</div><div class="stat-s">{% if editing_consistency and editing_consistency.interpretation %}{{ editing_consistency.interpretation }}{% endif %}</div></div>
      <div class="stat"><div class="stat-l">Brightness</div><div class="stat-v">{{ "%.2f"|format(color_stats.avg_brightness or 0) }}</div><div class="stat-s">0 dark · 1 bright</div></div>
    </div>
    {% set wd = color_stats.warmth_distribution %}
    {% set wt = (wd.warm or 0) + (wd.cool or 0) + (wd.neutral or 0) %}
    {% if wt > 0 %}
    {% for tone, col in [("warm","#f97316"),("cool","#38bdf8"),("neutral","#94a3b8")] %}
      {% set pct = ((wd[tone] or 0)/wt*100)|round|int %}
      <div class="dbar">
        <div class="dbar-row"><span>{{ tone|capitalize }}</span><span>{{ pct }}%</span></div>
        <div class="dbar-bg"><div class="dbar-fill" style="width:{{ pct }}%;background:{{ col }};"></div></div>
      </div>
    {% endfor %}
    {% endif %}
    <div id="hue-collapsible" class="collapsible-gear" style="max-height:0;overflow:hidden;">
    <div style="display:flex;justify-content:space-between;align-items:baseline;margin:0.9rem 0 0.4rem;">
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;">Hue Distribution</div>
      <div style="font-size:0.65rem;color:#606080;">dominant color ranges across your library (chromatic images, sat &gt; 15%)</div>
    </div>
    <div class="chart-h" style="max-height:160px;"><canvas id="hueChart" style="max-height:160px;"></canvas></div>
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin:0.8rem 0 0.4rem;">Saturation Distribution</div>
    {% set sh = saturation_histogram %}
    {% if sh and sh.buckets %}
    {% set sh_total = sh.buckets | sum or 1 %}
    <div style="height:18px;border-radius:4px;background:linear-gradient(to right,#2a2a3e 0%,rgba(236,72,153,0.25) 35%,rgba(236,72,153,0.65) 70%,#ec4899 100%);margin-bottom:6px;" title="Saturation from muted (left) to vivid (right)"></div>
    <div style="display:flex;gap:1px;margin-bottom:3px;">
      {% for v in sh.buckets %}
      {% set pct = (v / sh_total * 100)|round|int %}
      <div style="flex:1;text-align:center;font-size:0.58rem;color:{% if pct > 5 %}#9090b8{% else %}#4a4a68{% endif %};">{% if pct > 0 %}{{ pct }}%{% endif %}</div>
      {% endfor %}
    </div>
    <div style="display:flex;justify-content:space-between;font-size:0.6rem;color:#5a5a78;">
      <span>Muted</span><span>Vivid</span>
    </div>
    {% endif %}
    </div>
    <button onclick="_hueToggle(this)" style="margin-top:0.5rem;background:none;border:none;color:#5a5a78;font-size:0.68rem;cursor:pointer;padding:0;">Hue &amp; Saturation ↓</button>
  </div>
</div>

<!-- Signature Edit — full width accent -->
{% if signature_edit %}
<div class="card card-purple card-accent-top mb">
  <div class="card-title">Signature Edit</div>
  {% if signature_edit._narrative %}
  <div class="pull">{{ signature_edit._narrative }}</div>
  {% endif %}
  <div class="row two" style="margin-bottom:0;">
    <div>
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.6rem;">Tone</div>
      {% for key in ["Exposure2012","Highlights2012","Shadows2012","Whites2012","Blacks2012","Contrast2012"] %}
      {% set s = signature_edit.get(key) %}{% if s %}
      <div class="sig-row">
        <div class="sig-lbl"><span>{{ key.replace("2012","") }}</span><span>{{ '%+.1f'|format(s.median) }} ±{{ '%.0f'|format(s.std) }}</span></div>
        <div class="sig-track">
          <div class="sig-center"></div>
          {% set norm = s.norm if s.norm is defined else (s.median / 100.0) %}
          {% set bw = ([norm|abs, 1.0]|min) * 50 %}
          {% if norm >= 0 %}<div class="sig-pos" style="left:50%;width:{{ bw }}%;background:#7c6af7;"></div>
          {% else %}<div class="sig-neg" style="width:{{ bw }}%;background:#f97316;"></div>{% endif %}
        </div>
      </div>
      {% endif %}{% endfor %}
    </div>
    <div>
      <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.6rem;">Presence & Color</div>
      {% for key in ["Texture","Clarity","Dehaze","Vibrance","Saturation"] %}
      {% set s = signature_edit.get(key) %}{% if s %}
      <div class="sig-row">
        <div class="sig-lbl"><span>{{ key }}</span><span>{{ '%+.1f'|format(s.median) }} ±{{ '%.0f'|format(s.std) }}</span></div>
        <div class="sig-track">
          <div class="sig-center"></div>
          {% set norm = s.norm if s.norm is defined else (s.median / 100.0) %}
          {% set bw = ([norm|abs, 1.0]|min) * 50 %}
          {% if norm >= 0 %}<div class="sig-pos" style="left:50%;width:{{ bw }}%;background:#7c6af7;"></div>
          {% else %}<div class="sig-neg" style="width:{{ bw }}%;background:#f97316;"></div>{% endif %}
        </div>
      </div>
      {% endif %}{% endfor %}
      {% set wb = signature_edit.get("WhiteBalance") or signature_edit.get("Temperature") %}{% if wb %}
      <div class="sig-row">
        <div class="sig-lbl"><span>White Balance</span><span>{{ '%.0f'|format(wb.median) }}K · {% if wb.median > 5500 %}warm{% elif wb.median < 4500 %}cool{% else %}neutral{% endif %}</span></div>
        <div class="sig-track">
          <div class="sig-center"></div>
          {% set norm = wb.norm if wb.norm is defined else ((wb.median - 5500) / 3000.0) %}
          {% set bw = ([norm|abs, 1.0]|min) * 50 %}
          {% if norm >= 0 %}<div class="sig-pos" style="left:50%;width:{{ bw }}%;background:#f59e0b;"></div>
          {% else %}<div class="sig-neg" style="width:{{ bw }}%;background:#38bdf8;"></div>{% endif %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

<!-- Editing DNA (HSL fingerprint) -->
{% if hsl_fingerprint %}
<div class="card mb">
  <div class="card-title">Editing DNA <span style="color:#8080aa;font-weight:400;">HSL channel fingerprint · avg across Lightroom library</span></div>
  <div class="card-desc">How you systematically shift individual colour channels in post — your tonal and colour signature.</div>
  {% set hsl_channels = ["Red","Orange","Yellow","Green","Aqua","Blue","Purple","Magenta"] %}
  {% set ch_colors = {"Red":"#ef4444","Orange":"#f97316","Yellow":"#eab308","Green":"#22c55e","Aqua":"#06b6d4","Blue":"#3b82f6","Purple":"#8b5cf6","Magenta":"#ec4899"} %}
  <div style="display:grid;grid-template-columns:80px repeat(3,1fr);gap:3px;margin-bottom:4px;">
    <div></div>
    <div style="text-align:center;font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.06em;">Hue</div>
    <div style="text-align:center;font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.06em;">Sat</div>
    <div style="text-align:center;font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.06em;">Lum</div>
  </div>
  {% for ch in hsl_channels %}
  {% set row = hsl_fingerprint[ch] %}
  <div style="display:grid;grid-template-columns:80px repeat(3,1fr);gap:3px;margin-bottom:3px;align-items:center;">
    <div style="font-size:0.72rem;color:{{ ch_colors[ch] }};font-weight:600;">{{ ch }}</div>
    {% for val, key in [(row.hue_adj,'hue'),(row.sat_adj,'sat'),(row.lum_adj,'lum')] %}
    {% set intensity = [((val|abs)/15), 1.0] | min %}
    {% set bg = "rgba(124,106,247," + (intensity*0.85)|round(2)|string + ")" if val > 0 else ("rgba(239,68,68," + (intensity*0.75)|round(2)|string + ")" if val < 0 else "rgba(30,30,46,0.5)") %}
    <div style="background:{{ bg }};border-radius:4px;padding:3px 5px;text-align:center;font-size:0.72rem;color:{% if val|abs > 3 %}#e8e8f8{% else %}#7878a0{% endif %};">
      {{ "%+.1f"|format(val) }}
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  <div style="margin-top:0.5rem;font-size:0.68rem;color:#5a5a78;">Purple = raised &nbsp;·&nbsp; Red = lowered &nbsp;·&nbsp; Dark = near-zero</div>
</div>
{% endif %}

<!-- LR Develop Settings -->
{% if develop_stats and develop_stats.total_with_develop > 0 %}
<div class="card mb">
  <div class="card-title">Adobe Lightroom Develop Settings <span style="color:#8080aa;font-weight:400;">{{ develop_stats.total_with_develop }} of {{ photo_count }} images with develop metadata</span></div>
  <div class="card-desc" style="margin-bottom:0.9rem;">Avg slider positions across your library. Only images synced from Lightroom include develop settings — local folder imports don't carry this data. <strong style="color:#9090b8;">Lum. Noise</strong> = Luminance Smoothing, which reduces grain/texture noise in the brightness channel (high-ISO shots). <strong style="color:#9090b8;">Color NR</strong> = Color Noise Reduction, which removes coloured speckles (chroma noise) in shadow areas.</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin-top:4px;">
    {% for key, label in [("Contrast","Contrast"),("Shadows","Shadows"),("Vibrance","Vibrance"),("Saturation","Saturation"),("Sharpness","Sharpness"),("LuminanceSmoothing","Lum. Noise"),("ColorNoiseReduction","Color NR")] %}
    {% set val = develop_stats.avg.get(key) %}{% if val is not none %}
    <div style="background:#16161f;border-radius:7px;padding:10px;">
      <div style="color:#7878a0;font-size:10px;margin-bottom:2px;">{{ label }}</div>
      <div style="font-size:1.1rem;font-weight:700;color:{% if val > 0 %}#34d399{% elif val < 0 %}#f87171{% else %}#9090b8{% endif %};">{% if val > 0 %}+{% endif %}{{ "%.1f"|format(val) }}</div>
      <div style="height:3px;background:#1e1e2e;border-radius:2px;margin-top:6px;">
        {% set p = [(val+100)/200*100,0]|max %}{% set p = [p,100]|min %}
        <div style="width:{{ p|int }}%;height:3px;background:{% if val > 0 %}#34d399{% elif val < 0 %}#f87171{% else %}#9090b8{% endif %};border-radius:2px;"></div>
      </div>
    </div>
    {% endif %}{% endfor %}
  </div>
  {% if develop_stats.by_scene %}
  {% set dev_sliders = [("Exposure2012","Exposure"),("Contrast","Contrast"),("Highlights2012","Highlights"),("Shadows2012","Shadows"),("Whites2012","Whites"),("Blacks2012","Blacks"),("Vibrance","Vibrance"),("Saturation","Saturation"),("Sharpness","Sharpness"),("LuminanceSmoothing","Lum. Noise"),("ColorNoiseReduction","Color NR")] %}
  {% set dev_scenes = develop_stats.by_scene.keys() | list %}
  <details style="margin-top:1.2rem;">
    <summary style="cursor:pointer;list-style:none;font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.08em;padding:0.3rem 0;">Avg Slider Value by Scene ▾</summary>
    <div style="margin-top:0.6rem;overflow-x:auto;">
    <table style="width:100%;border-collapse:separate;border-spacing:2px;font-size:0.68rem;table-layout:fixed;">
      <colgroup>
        <col style="width:90px;">
        {% for sc in dev_scenes %}<col style="width:{{ (100 / (dev_scenes|length + 0.0001))|round(1) }}%;">{% endfor %}
      </colgroup>
      <thead>
        <tr>
          <th style="text-align:left;padding:3px 8px;color:#7878a0;font-weight:400;"></th>
          {% for sc in dev_scenes %}
          <th style="padding:3px 5px;color:#8080aa;font-weight:400;text-transform:capitalize;font-size:0.62rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ sc.replace(" and ", " & ") }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
      {% for key, label in dev_sliders %}
      {% if develop_stats.avg.get(key) is not none %}
      <tr>
        <td style="padding:3px 8px;color:#9090b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ label }}</td>
        {% for sc in dev_scenes %}
        {% set val = develop_stats.by_scene[sc].get(key) %}
        {% if val is not none %}
        {% set intensity = [(val|abs)/30, 1.0]|min %}
        {% set bg = "rgba(52,211,153," + (intensity*0.75)|round(2)|string + ")" if val > 0 else ("rgba(248,113,113," + (intensity*0.7)|round(2)|string + ")" if val < 0 else "rgba(30,30,46,0.4)") %}
        <td style="text-align:center;padding:4px 6px;background:{{ bg }};border-radius:4px;color:{% if val|abs > 5 %}#e8e8f8{% else %}#7878a0{% endif %};font-variant-numeric:tabular-nums;">{{ "%+.0f"|format(val) }}</td>
        {% else %}
        <td style="text-align:center;padding:4px 6px;color:#303044;font-size:0.6rem;">—</td>
        {% endif %}
        {% endfor %}
      </tr>
      {% endif %}
      {% endfor %}
      </tbody>
    </table>
    <div style="margin-top:0.5rem;font-size:0.68rem;color:#505070;">Green = pushed above default &nbsp;·&nbsp; Red = pulled below &nbsp;·&nbsp; Intensity = magnitude of avg shift</div>
    </div>
  </details>
  {% endif %}
</div>
{% endif %}

<!-- Color & Composition by Scene — visual tiles -->
{% if color_by_scene %}
<div class="card mb">
  <div class="card-title">Color Profile, Aesthetic Score &amp; Editing Intensity by Scene</div>
  <div class="color-scene-grid">
    {% set scene_colors_map = {"nature":"#10b981","architecture":"#7c6af7","urban street":"#f97316","people and portraits":"#f59e0b","abstract":"#ec4899","travel and landmarks":"#3b82f6","food":"#ef4444","interior":"#14b8a6","animals":"#a855f7","night scene":"#6366f1","unknown":"#64748b"} %}
    {% for scene, d in color_by_scene.items() | sort(attribute='1.avg_aesthetic', reverse=True) %}
    {% if d.count > 0 %}
    {% set col = scene_colors_map.get(scene, "#7c6af7") %}
    <div class="color-scene-card" style="background:{{ col }}0d;border-color:{{ col }}22;">
      <div class="cs-name">{{ scene }}</div>
      <div class="cs-temp" style="color:{% if d.dominant_warmth=='warm' %}#f97316{% elif d.dominant_warmth=='cool' %}#38bdf8{% else %}#94a3b8{% endif %};">
        {% if d.dominant_warmth == "warm" %}Warm{% elif d.dominant_warmth == "cool" %}Cool{% else %}Neutral{% endif %}
      </div>
      <div style="height:3px;background:{{ col }}33;border-radius:2px;margin:0.4rem 0;">
        <div style="width:{{ ((d.avg_saturation or 0)*100)|int }}%;height:3px;background:{{ col }};border-radius:2px;opacity:0.8;"></div>
      </div>
      <div class="cs-pills">
        {% if d.avg_aesthetic %}<span class="cs-pill" style="color:{{ col }};">⬡ {{ "%.1f"|format(d.avg_aesthetic) }}</span>{% endif %}
        {% if iq_by_scene.get(scene) is not none %}<span class="cs-pill" style="color:#10b981;">IQ {{ iq_by_scene[scene] }}</span>{% endif %}
        {% if d.aesthetic_std is not none %}<span class="cs-pill">σ {{ "%.2f"|format(d.aesthetic_std) }}</span>{% endif %}
        {% if d.editing_intensity is defined and d.editing_intensity is not none %}<span class="cs-pill">✏ {{ d.editing_intensity|round(0)|int }}</span>{% endif %}
        <span class="cs-pill">sat {{ "%.2f"|format(d.avg_saturation or 0) }}</span>
        <span class="cs-pill">bri {{ "%.2f"|format(d.avg_brightness or 0) }}</span>
        {% if d.avg_contrast is not none %}<span class="cs-pill">con {{ "%.2f"|format(d.avg_contrast) }}</span>{% endif %}
        <span class="cs-pill">{{ d.count }} images</span>
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
  <div style="margin-top:0.75rem;font-size:0.68rem;color:#5a5a78;">⬡ = avg aesthetic score · IQ = avg technical quality · σ = consistency (lower = more uniform) · ✏ = editing intensity</div>
</div>
{% endif %}

<!-- Editing Trends -->
{% if editing_trends and editing_trends|length > 1 %}
<div class="card mb">
  <div class="card-title">Editing Trends Over Time</div>
  <div class="chart-h" style="height:220px;"><canvas id="trendsChart" style="max-height:220px;"></canvas></div>
  {% if period_stats and period_stats.early and period_stats.recent %}
  <div style="display:flex;gap:0.75rem;margin-top:1rem;flex-wrap:wrap;">
    {% for label, ps in period_stats.items() %}
    <div style="flex:1;min-width:120px;background:#13131f;border-radius:8px;padding:0.7rem 0.85rem;border:1px solid #1a1a28;">
      <div style="font-size:0.62rem;text-transform:uppercase;letter-spacing:0.05em;color:#9090b8;margin-bottom:0.4rem;">{{ label }}</div>
      <div style="font-size:1.15rem;font-weight:700;color:#c8c8e8;">{{ "%.1f"|format(ps.avg_aesthetic) if ps.avg_aesthetic is not none else "—" }}</div>
      <div style="font-size:0.62rem;color:#7878a0;margin-bottom:0.3rem;">avg aesthetic</div>
      <div style="display:flex;gap:0.6rem;flex-wrap:wrap;">
        <span style="font-size:0.68rem;"><span style="color:#7c6af7;font-weight:600;">{{ "%.0f"|format(ps.avg_edit_intensity) if ps.avg_edit_intensity is not none else "—" }}</span> <span style="color:#7878a0;">intensity</span></span>
        <span style="font-size:0.68rem;"><span style="color:#10b981;font-weight:600;">{{ "%.0f"|format(ps.automation_score * 100) if ps.automation_score is not none else "—" }}%</span> <span style="color:#7878a0;">automated</span></span>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}

<!-- Portfolio Albums (moved before WHEN YOU SHOOT) -->
{% if album_stats and album_stats.total_albums > 0 %}
<div class="card mb">
  <div class="card-title">Portfolio Albums <span style="color:#8080aa;font-weight:400;">Adobe Lightroom collections · curated selections</span></div>
  <div class="card-desc">Images you've placed in albums represent your curated portfolio — the subset you've actively chosen to showcase. Comparing album images against the rest of your library shows how well the AI aesthetic model aligns with your own taste.</div>
  <div class="strip mb">
    <div class="strip-item">
      <div class="strip-v">{{ album_stats.total_albums }}</div>
      <div class="strip-l">Albums</div>
      <div class="strip-s">Lightroom collections</div>
    </div>
    <div class="strip-item">
      <div class="strip-v">{{ album_stats.total_in_albums }}</div>
      <div class="strip-l">Curated Images</div>
      <div class="strip-s">of {{ album_stats.total_trackable }} Lightroom images</div>
    </div>
    <div class="strip-item">
      <div class="strip-v" style="color:#7c6af7;">{{ album_stats.curation_rate }}%</div>
      <div class="strip-l">Curation Rate</div>
      <div class="strip-s">in at least one album</div>
    </div>
  </div>

  {% if album_stats.avg_aesthetic_in is not none and album_stats.avg_aesthetic_out is not none %}
  <div style="margin-bottom:1rem;padding:0.75rem 1rem;background:#16161f;border-radius:8px;">
    <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.6rem;">AI Aesthetic Agreement</div>
    <div style="display:flex;gap:2rem;align-items:center;flex-wrap:wrap;">
      <div>
        <div style="font-size:1.2rem;font-weight:700;color:#7c6af7;">{{ "%.1f"|format(album_stats.avg_aesthetic_in) }}</div>
        <div style="font-size:0.68rem;color:#7878a0;">avg score · in albums</div>
      </div>
      <div style="font-size:1.4rem;color:#3a3a50;">vs</div>
      <div>
        <div style="font-size:1.2rem;font-weight:700;color:#9090b8;">{{ "%.1f"|format(album_stats.avg_aesthetic_out) }}</div>
        <div style="font-size:0.68rem;color:#7878a0;">avg score · not in albums</div>
      </div>
      {% set delta = album_stats.avg_aesthetic_in - album_stats.avg_aesthetic_out %}
      <div style="margin-left:auto;">
        <div style="font-size:1rem;font-weight:700;color:{% if delta > 1 %}#34d399{% elif delta < -1 %}#f87171{% else %}#f59e0b{% endif %};">{{ "%+.1f"|format(delta) }}</div>
        <div style="font-size:0.68rem;color:#7878a0;">model bias</div>
      </div>
    </div>
    <div style="margin-top:0.6rem;font-size:0.7rem;color:#606080;">
      {% if delta > 2 %}The model strongly agrees with your curation — it scores your chosen images noticeably higher.
      {% elif delta > 0.5 %}The model leans toward agreeing with your selections — a modest positive bias.
      {% elif delta > -0.5 %}The model is essentially neutral — it doesn't distinguish your curated images from the rest.
      {% else %}The model disagrees with your curation — it scores your non-album images higher. Your taste differs from the aesthetic-predictor-v2-5 training aesthetic.{% endif %}
    </div>
  </div>
  {% endif %}

  {% if album_stats.albums %}
  <details style="margin-top:0.75rem;">
    <summary style="cursor:pointer;font-size:0.78rem;color:#7878a0;list-style:none;padding:0.3rem 0;">Show album details ▾</summary>
  <table style="width:100%;border-collapse:collapse;margin-top:0.5rem;">
    <thead><tr>
      <th style="text-align:left;padding:4px 8px;font-size:0.68rem;color:#7878a0;border-bottom:1px solid #1a1a28;">Album</th>
      <th style="text-align:right;padding:4px 8px;font-size:0.68rem;color:#7878a0;border-bottom:1px solid #1a1a28;">Images</th>
      <th style="text-align:right;padding:4px 8px;font-size:0.68rem;color:#7878a0;border-bottom:1px solid #1a1a28;white-space:nowrap;">Avg Aesthetic</th>
      <th style="text-align:right;padding:4px 8px;font-size:0.68rem;color:#7878a0;border-bottom:1px solid #1a1a28;">σ</th>
      <th style="text-align:right;padding:4px 8px;font-size:0.68rem;color:#7878a0;border-bottom:1px solid #1a1a28;white-space:nowrap;">Edit Intensity</th>
      <th style="text-align:left;padding:4px 8px;font-size:0.68rem;color:#7878a0;border-bottom:1px solid #1a1a28;">Palette</th>
    </tr></thead>
    <tbody>
    {% for a in album_stats.albums %}
    <tr>
      <td style="padding:5px 8px;font-size:0.78rem;color:#c0c0d8;">{{ a.name }}</td>
      <td style="padding:5px 8px;font-size:0.78rem;color:#9090b8;text-align:right;">{{ a.count }}</td>
      <td style="padding:5px 8px;font-size:0.82rem;color:#7c6af7;text-align:right;font-weight:600;">{{ "%.1f"|format(a.avg_aesthetic) if a.avg_aesthetic is not none else "—" }}</td>
      <td style="padding:5px 8px;font-size:0.72rem;color:#7878a0;text-align:right;">{{ "%.2f"|format(a.aesthetic_std) if a.aesthetic_std is not none else "—" }}</td>
      <td style="padding:5px 8px;font-size:0.72rem;color:#9090b8;text-align:right;">{{ a.avg_editing_intensity|round(0)|int if a.avg_editing_intensity is not none else "—" }}</td>
      <td style="padding:5px 8px;">{% if a.top_colors %}{% for c in a.top_colors %}<span style="display:inline-block;width:13px;height:13px;background:{{ c }};border-radius:2px;margin-right:1px;vertical-align:middle;" title="{{ c }}"></span>{% endfor %}{% else %}<span style="font-size:0.65rem;color:#5a5a78;">—</span>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </details>
  {% endif %}
</div>
{% endif %}

</details>

<!-- ══════════════════════════════════════ EDITING JOURNEY ════════════════ -->
{% if _sources.has_lightroom %}
<details open id="s-editing-journey" style="margin-bottom:0;">
<summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 0 0.5rem;font-size:0.68rem;font-weight:700;color:#7878a0;text-transform:uppercase;letter-spacing:0.12em;border-bottom:1px solid #1a1a2e;margin-bottom:1rem;" class="section-summary">Editing Journey</summary>

{% if editing_journey and editing_journey|length > 1 %}
<div class="card mb">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.5rem;">
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <div class="card-title" style="margin:0;">Editing Journey Over Time</div>
      <div style="display:flex;gap:0;border:1px solid #2a2a3e;border-radius:8px;overflow:hidden;">
        <button id="ejModeZ"   onclick="ejSetMode('z')"   style="padding:2px 10px;font-size:0.62rem;font-weight:600;background:#7c6af722;color:#7c6af7;border:none;cursor:pointer;">σ Normalized</button>
        <button id="ejModeRaw" onclick="ejSetMode('raw')" style="padding:2px 10px;font-size:0.62rem;font-weight:400;background:transparent;color:#5a5a78;border:none;cursor:pointer;">Raw values</button>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.3rem;" id="ejParamPicker">
      {% set _ej_active_default = ["Exposure2012","Highlights2012","Whites2012","Blacks2012","Contrast2012"] %}
      {% for key, label, col in [
        ("Exposure2012","Exposure","#f59e0b"),("Highlights2012","Highlights","#34d399"),
        ("Shadows2012","Shadows","#818cf8"),("Whites2012","Whites","#e2e8f0"),
        ("Blacks2012","Blacks","#64748b"),("Contrast2012","Contrast","#fb923c"),
        ("Clarity2012","Clarity","#7c6af7"),("Texture","Texture","#60a5fa"),
        ("Dehaze","Dehaze","#a78bfa"),("Saturation","Saturation","#f97316"),
        ("Vibrance","Vibrance","#10b981"),("GrainAmount","Grain","#9090b8")] %}
      <button data-ej-key="{{ key }}" data-ej-col="{{ col }}" onclick="ejToggle(this)" style="padding:2px 8px;font-size:0.65rem;border-radius:12px;border:1px solid {{ col }};background:{% if key in _ej_active_default %}{{ col }}22{% else %}transparent{% endif %};color:{{ col }};cursor:pointer;opacity:{% if key in _ej_active_default %}1{% else %}0.45{% endif %};">{{ label }}</button>
      {% endfor %}
    </div>
  </div>
  <div style="font-size:0.68rem;color:#5a5a78;margin-bottom:0.4rem;line-height:1.5;">
    <span style="color:#7c6af7;font-weight:600;">σ Normalized</span> — each slider is centred on its own library average and scaled by its std deviation. <span style="color:#c0c0d8;">0σ = your typical use</span> · <span style="color:#c0c0d8;">+1σ = heavier than usual</span> · <span style="color:#c0c0d8;">−1σ = lighter than usual</span>. All sliders are directly comparable regardless of absolute scale. &nbsp;<span style="color:#5a5a78;">|</span>&nbsp; <span style="color:#9090b8;font-weight:500;">Raw values</span> — actual slider units; useful when studying a single slider in detail.
  </div>
  <div class="chart-h" style="height:240px;"><canvas id="editingJourneyChart" style="max-height:240px;"></canvas></div>
</div>
<div class="card mb">
  <div class="card-title">Workflow Adoption <span style="color:#8080aa;font-weight:400;">% of images per month using each technique · includes automation score</span></div>
  <div class="chart-h" style="height:220px;"><canvas id="adoptionChart" style="max-height:220px;"></canvas></div>
</div>
{% endif %}

{% if edit_recency and edit_recency.values() | sum > 0 %}
{% set er_total = edit_recency.values() | sum %}
<div class="card mb">
  <div class="card-title">Edit Recency <span style="color:#8080aa;font-weight:400;font-size:0.6rem;">how soon after capture were photos edited</span></div>
  <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
    {% set er_items = [("same_day","Same Day","#4ade80"),("within_week","Within Week","#a3e635"),("within_month","Within Month","#f59e0b"),("later","Later","#9090b8")] %}
    {% for key, label, color in er_items %}
    {% set cnt = edit_recency.get(key, 0) %}
    {% set pct = (cnt / er_total * 100)|round|int %}
    <div style="flex:1;min-width:80px;text-align:center;background:#13131f;border-radius:8px;padding:0.6rem 0.4rem;">
      <div style="font-size:1.3rem;font-weight:700;color:{{ color }};">{{ pct }}%</div>
      <div style="font-size:0.68rem;color:#7878a0;margin-top:2px;">{{ label }}</div>
      <div style="font-size:0.62rem;color:#505068;">{{ cnt }} images</div>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{% endif %}{# has_lightroom #}
</details>

<!-- ══════════════════════════════════════ WHEN YOU SHOOT ══════════════════ -->
<details open id="s-when" style="margin-bottom:0;">
<summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 0 0.5rem;font-size:0.68rem;font-weight:700;color:#7878a0;text-transform:uppercase;letter-spacing:0.12em;border-bottom:1px solid #1a1a2e;margin-bottom:1rem;" class="section-summary">When You Shoot</summary>

<div class="row {% if dow_distribution and dow_distribution.values() | sum > 0 %}three{% else %}two{% endif %} mb">
  <div class="card">
    <div class="card-title">Shooting Hours <span style="color:#8080aa;font-weight:400;">golden hour = 5–7 AM/PM highlighted</span></div>
    <div class="chart-h" style="height:220px;"><canvas id="hoursChart" style="max-height:220px;"></canvas></div>
  </div>
