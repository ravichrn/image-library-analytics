<script>
const SC = ["#f87171","#fb923c","#fbbf24","#a3e635","#4ade80","#34d399","#22d3ee","#60a5fa","#818cf8","#e879f9","#f472b6","#38bdf8"];
const GD = { responsive: true, plugins: { legend: { display: false } }, scales: {
  x: { grid: { color: "#14142a" }, ticks: { color: "#8080aa", font: { size: 13 } } },
  y: { grid: { color: "#14142a" }, ticks: { color: "#8080aa", font: { size: 13 } } },
}};

// Scene doughnut
(function() {
  const sd = {{ scene_dist | tojson }};
  const labels = Object.keys(sd).filter(k => sd[k] > 0);
  const data = labels.map(k => sd[k]);
  const total = data.reduce((a,b) => a+b, 0);
  new Chart(document.getElementById("sceneChart"), {
    type: "doughnut",
    data: { labels: labels.map((k,i) => `${k} (${Math.round(data[i]/total*100)}%)`), datasets: [{ data, backgroundColor: SC, borderWidth: 0 }] },
    options: { responsive: true, cutout: "62%",
      plugins: { legend: { display: true, position: "bottom",
        labels: { color: "#6060881", boxWidth: 10, font: { size: 12 }, color: "#9090b8", padding: 10 }},
        tooltip: { callbacks: { label: ctx => ` ${ctx.raw} images (${Math.round(ctx.raw/total*100)}%)` }}
      }
    }
  });
})();

// UMAP
(function() {
  const pts = {{ umap_points | tojson }};
  if (!pts.length) return;
  const allScenes = [...new Set(pts.map(p => p.scene_type))].sort();
  const sc = {}; allScenes.forEach((s,i) => sc[s] = SC[i % SC.length]);
  const ds = {};
  pts.forEach(p => {
    if (!ds[p.scene_type]) ds[p.scene_type] = { label: p.scene_type, data: [], backgroundColor: sc[p.scene_type] + "88", pointRadius: 3, pointHoverRadius: 6 };
    ds[p.scene_type].data.push({ x: p.x, y: p.y, path: p.path, score: p.aesthetic_score, thumb: p.thumb, scene_type: p.scene_type });
  });

  // Custom thumbnail tooltip overlay
  const umapWrap = document.getElementById("umapChart").parentElement;
  umapWrap.style.position = "relative";
  const tip = document.createElement("div");
  tip.style.cssText = "position:absolute;pointer-events:none;display:none;background:#10101a;border:1px solid #2a2a3a;border-radius:8px;padding:8px;z-index:10;box-shadow:0 4px 16px #00000088;min-width:100px;text-align:center;";
  umapWrap.appendChild(tip);

  new Chart(document.getElementById("umapChart"), {
    type: "scatter", data: { datasets: Object.values(ds) },
    options: { responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: true, labels: { color: "#9090b8", boxWidth: 9, font: { size: 12 } }},
        tooltip: { enabled: false, external: (ctx) => {
          const el = ctx.chart.canvas;
          const rect = el.getBoundingClientRect();
          if (!ctx.tooltip.dataPoints || !ctx.tooltip.dataPoints.length) { tip.style.display = "none"; return; }
          const d = ctx.tooltip.dataPoints[0].raw;
          let html = "";
          if (d.thumb) {
            html += `<img src="data:image/jpeg;base64,${d.thumb}" style="width:72px;height:72px;object-fit:cover;border-radius:5px;display:block;margin:0 auto 5px;">`;
            html += `<div style="font-size:10px;color:#7c6af7;font-weight:600;margin-bottom:2px;">★ Album</div>`;
          } else {
            html += `<div style="font-size:10px;color:#7878a0;font-family:monospace;margin-bottom:3px;">${d.path || ""}</div>`;
          }
          html += `<div style="font-size:11px;color:#9090b8;text-transform:capitalize;">${d.scene_type || ""}</div>`;
          if (d.score != null) html += `<div style="font-size:11px;color:#a78bfa;font-weight:600;">Score ${d.score.toFixed(1)}</div>`;
          tip.innerHTML = html;
          tip.style.display = "block";
          const tipW = 100, tipH = 120;
          let left = ctx.tooltip.caretX + 10, top = ctx.tooltip.caretY - tipH / 2;
          if (left + tipW > el.offsetWidth) left = ctx.tooltip.caretX - tipW - 10;
          top = Math.max(0, Math.min(top, el.offsetHeight - tipH));
          tip.style.left = left + "px"; tip.style.top = top + "px";
        }}
      },
      scales: { x: { grid: { color: "#14142a" }, ticks: { display: false } }, y: { grid: { color: "#14142a" }, ticks: { display: false } } }
    }
  });
  document.getElementById("umapChart").addEventListener("mouseleave", () => { tip.style.display = "none"; });
})();

// Focal length
(function() {
  const vals = {{ focal_length_histogram | tojson }};
  if (!vals.length) return;
  const buckets = [["<24mm",0,24],["24–35mm",24,35],["35–50mm",35,50],["50–85mm",50,85],["85–135mm",85,135],["135mm+",135,1e9]];
  new Chart(document.getElementById("focalChart"), {
    type: "bar",
    data: { labels: buckets.map(b=>b[0]), datasets: [{ data: buckets.map(b => vals.filter(v=>v>=b[1]&&v<b[2]).length), backgroundColor: "#f97316aa", borderRadius: 4 }] },
    options: { ...GD }
  });
})();

// Aperture
(function() {
  const vals = {{ aperture_histogram | tojson }};
  if (!vals.length) return;
  const stops = [1.4,1.8,2,2.8,4,5.6,8,11,16,22];
  new Chart(document.getElementById("apertureChart"), {
    type: "bar",
    data: { labels: stops.map((s,i) => i===0?"≤f/"+s:"f/"+s),
            datasets: [{ data: stops.map((s,i) => { const lo=i===0?0:stops[i-1]; return vals.filter(v=>v>lo&&v<=s).length; }), backgroundColor: "#10b981aa", borderRadius: 4 }] },
    options: { ...GD }
  });
})();

// ISO
(function() {
  const vals = {{ iso_histogram | tojson }};
  if (!vals.length) return;
  const b = [["≤100",0,100],["101–400",100,400],["401–800",400,800],["801–1600",800,1600],["1601–3200",1600,3200],["3201+",3200,1e9]];
  new Chart(document.getElementById("isoChart"), {
    type: "bar",
    data: { labels: b.map(x=>x[0]), datasets: [{ data: b.map(x => vals.filter(v=>v>x[1]&&v<=x[2]).length), backgroundColor: "#f59e0baa", borderRadius: 4 }] },
    options: { ...GD }
  });
})();

// aestheticChart removed — all scores in one bucket, histogram uninformative

// Hue
(function() {
  const hd = {{ hue_distribution | tojson }};
  if (!hd.buckets) return;
  const hc = ["#ef4444","#f97316","#eab308","#84cc16","#22c55e","#10b981","#06b6d4","#3b82f6","#6366f1","#8b5cf6","#a855f7","#ec4899"];
  new Chart(document.getElementById("hueChart"), {
    type: "bar",
    data: { labels: hd.labels, datasets: [{ data: hd.buckets, backgroundColor: hc.map(c=>c+"cc"), borderRadius: 3 }] },
    options: { responsive: true, plugins: { legend: { display: false } },
      scales: { x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", font: { size: 9 }, maxRotation: 45 } }, y: { grid: { color: "#14142a" }, ticks: { color: "#7878a0" } } }}
  });
})();

// Saturation histogram
(function() {
  const sd = {{ saturation_histogram | tojson }};
  if (!sd.buckets) return;
  new Chart(document.getElementById("satHistChart"), {
    type: "bar",
    data: { labels: sd.labels, datasets: [{ data: sd.buckets, backgroundColor: "#ec4899aa", borderRadius: 3 }] },
    options: { responsive: true, plugins: { legend: { display: false } },
      scales: { x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", font: { size: 9 } } }, y: { grid: { color: "#14142a" }, ticks: { color: "#7878a0" } } }}
  });
})();

// Shooting hours
(function() {
  const sh = {{ shooting_hours | tojson }};
  const labels = Array.from({length:24},(_,i)=>i+"h");
  const data = labels.map((_,i) => sh[String(i)]||0);
  const colors = data.map((_,i) => (i>=5&&i<=7)||(i>=17&&i<=19) ? "#f59e0bbb" : "#7c6af744");
  new Chart(document.getElementById("hoursChart"), {
    type: "bar",
    data: { labels, datasets: [{ data, backgroundColor: colors, borderRadius: 3 }] },
    options: { ...GD, maintainAspectRatio: false }
  });
})();

// Monthly
(function() {
  const ms = {{ monthly_shooting | tojson }};
  const months = Object.keys(ms).sort();
  if (months.length < 2) return;
  const totals = months.map(m => ms[m].total ?? ms[m]);
  const golden = months.map(m => ms[m].golden_hour ?? 0);
  const other  = months.map((m,i) => totals[i] - golden[i]);
  new Chart(document.getElementById("monthlyChart"), {
    type: "bar",
    data: { labels: months.map(m=>m.slice(0,7)), datasets: [
      { label: "Other",       data: other,  backgroundColor: "#7c6af733", borderColor: "#7c6af755", borderWidth: 1, borderRadius: 0, stack: "s" },
      { label: "Golden Hour", data: golden, backgroundColor: "#f9a82555", borderColor: "#f9a82599", borderWidth: 1, borderRadius: 3, stack: "s" },
    ]},
    options: { ...GD, maintainAspectRatio: false,
      plugins: {
        legend: { display: true, labels: { color: "#7878a0", boxWidth: 10, font: { size: 10 } } },
        tooltip: { callbacks: { label: ctx => ` ${ctx.dataset.label}: ${ctx.raw}` } }
      },
      scales: {
        x: { stacked: true, grid: { color: "#14142a" }, ticks: { color: "#7878a0", maxRotation: 45, font: { size: 9 } } },
        y: { stacked: true, grid: { color: "#14142a" }, ticks: { color: "#7878a0" } }
      }
    }
  });
})();

// Editing trends
(function() {
  const trends = {{ editing_trends | tojson }};
  const months = Object.keys(trends).sort();
  if (months.length < 2) return;
  new Chart(document.getElementById("trendsChart"), {
    type: "line",
    data: { labels: months, datasets: [
      { label: "Aesthetic", data: months.map(m=>trends[m].avg_aesthetic), borderColor: "#7c6af7", backgroundColor: "#7c6af715", tension: 0.3, yAxisID: "y1", fill: true, pointRadius: 3 },
      { label: "Saturation", data: months.map(m=>trends[m].avg_saturation), borderColor: "#f97316", tension: 0.3, yAxisID: "y2", pointRadius: 2, borderDash: [4,3] },
      { label: "Brightness", data: months.map(m=>trends[m].avg_brightness), borderColor: "#10b981", tension: 0.3, yAxisID: "y2", pointRadius: 2, borderDash: [2,4] },
    ]},
    options: { responsive: true, interaction: { mode: "index", intersect: false },
      plugins: { legend: { display: true, labels: { color: "#5a5a78", boxWidth: 12, font: { size: 11 } }}},
      scales: {
        x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", maxRotation: 45 }},
        y1: { position: "left", grid: { color: "#14142a" }, ticks: { color: "#7878a0" }, title: { display: true, text: "Aesthetic", color: "#7c6af7", font: { size: 10 }}},
        y2: { position: "right", grid: { drawOnChartArea: false }, ticks: { color: "#7878a0" }, min: 0, max: 1 },
      }
    }
  });
})();


// Keywords
{% set _kw_data = keyword_map.top_keywords if (keyword_map and keyword_map.top_keywords) else [] %}
(() => {
  const el = document.getElementById("keywordsChart");
  if (!el) return;
  const kws = {{ _kw_data | tojson }};
  const top = kws.slice(0,20);
  new Chart(el, { type: "bar",
    data: { labels: top.map(k=>k.word||k.keyword), datasets: [{ data: top.map(k=>k.count), backgroundColor: "#7c6af7bb", borderRadius: 3 }] },
    options: { indexAxis: "y", responsive: true, plugins: { legend: { display: false }},
      scales: { x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0" }}, y: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", font: { size: 11 }}} }}
  });
})();
</script>

<!-- Technical IQ Stats -->
{% if iq_stats and not iq_stats.unavailable %}
<div class="card mb">
  <div class="card-title">Technical IQ Score <span style="color:#8080aa;font-weight:400;">MUSIQ · 0–1 scale · higher = better sharpness &amp; exposure</span></div>
  <div class="strip mb">
    <div class="strip-item">
      <div class="strip-v">{{ "%.2f"|format(iq_stats.avg) if iq_stats.avg is not none else "—" }}</div>
      <div class="strip-l">Avg IQ Score</div>
      <div class="strip-s">std {{ "%.2f"|format(iq_stats.std) if iq_stats.std is not none else "—" }}</div>
    </div>
    {% if iq_stats.high_aesthetic_low_iq_count > 0 %}
    <div class="strip-item">
      <div class="strip-v" style="color:#fbbf24;">{{ iq_stats.high_aesthetic_low_iq_count }}</div>
      <div class="strip-l">High Aesthetic, Low IQ</div>
      <div class="strip-s">beautiful but technically soft</div>
    </div>
    {% endif %}
  </div>
  {% if iq_stats.distribution %}
  <div style="font-size:0.68rem;color:#7878a0;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.5rem;">Score Distribution</div>
  <div class="chart-h" style="height:140px;"><canvas id="iqDistChart"></canvas></div>
  <script>
  (() => {
    const el = document.getElementById("iqDistChart");
    if (!el) return;
    const dist = {{ iq_stats.distribution | tojson }};
    const labels = dist.map((_, i) => (i/10).toFixed(1) + "–" + ((i+1)/10).toFixed(1));
    new Chart(el, { type: "bar",
      data: { labels, datasets: [{ data: dist, backgroundColor: "#34d399bb", borderRadius: 3 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }},
        scales: { x: { grid: { color: "#14142a" }, ticks: { color: "#7878a0", font: { size: 10 }}}, y: { grid: { color: "#14142a" }, ticks: { color: "#7878a0" }}}}
    });
  })();
  </script>
  {% endif %}
</div>
{% endif %}


</div><!-- /.page -->
</div><!-- /#main-content -->

<button id="back-to-top" aria-label="Back to top">↑</button>

<script>
(function() {
  const sbLinks = Array.from(document.querySelectorAll("#sidebar a"));
  const targets = sbLinks.map(a => document.querySelector(a.getAttribute("href")));
  function update() {
    let current = 0;
    targets.forEach((el, i) => { if (el && el.getBoundingClientRect().top <= 90) current = i; });
    sbLinks.forEach((a, i) => a.classList.toggle("sb-active", i === current));
  }
  window.addEventListener("scroll", update, { passive: true });
  update();
})();

(function () {
  const btn = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    btn.classList.toggle('visible', window.scrollY / document.body.scrollHeight > 0.15);
  }, { passive: true });
  btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
})();
</script>

</body>
