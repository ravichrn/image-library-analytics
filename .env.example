# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required for gated models (e.g. RMBG-2.0). Get token at huggingface.co/settings/tokens
HF_TOKEN=

# ── Sources ───────────────────────────────────────────────────────────────────
# Comma-separated: local, lightroom (or both)
SOURCES=local

# ── Local source ──────────────────────────────────────────────────────────────
PHOTO_DIR=~/Pictures/Edits

# ── Performance ───────────────────────────────────────────────────────────────
# Set to true to skip the CLIP-IQA+ technical quality pass (Pass 3b). Useful for
# large libraries where IQ scoring is the bottleneck — all other passes are unaffected.
SKIP_IQ=false

# Set to true to embed image thumbnails in the UMAP hover tooltip.
# Thumbnails are 72×72 JPEG base64-encoded (~2–3KB each for album images).
# Default false keeps the HTML file small.
SHOW_THUMBNAILS=false

# ── Lightroom source ──────────────────────────────────────────────────────────
LIGHTROOM_CLIENT_ID=
LIGHTROOM_CLIENT_SECRET=
LIGHTROOM_REDIRECT_URI=https://localhost:8765/callback
# Written automatically after first login — do not edit manually
LIGHTROOM_REFRESH_TOKEN=
